@inject IJSRuntime JsRuntime
@using System.Globalization
@using SQLCommandProfiler

<div class="profiler-stream @(ShowHeader ? "card h-100 w-100" : "profiler-stream-panel w-100") @ThemeClass">
    @if (ShowHeader)
    {
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <strong>@Title</strong>
            <span class="badge text-bg-secondary">@Items.Count</span>
        </div>
    }
    <div class="@(ShowHeader ? "card-body" : string.Empty) p-2 d-flex flex-column profiler-stream-body">
        <div class="form-check form-check-sm mb-2 flex-shrink-0">
            <input class="form-check-input"
                   type="checkbox"
                   id="@_autoScrollId"
                   checked="@AutoScroll"
                   @onchange="OnAutoScrollChanged" />
            <label class="form-check-label small" for="@_autoScrollId">Autoscroll</label>
        </div>
        <div class="profiler-table-scroll flex-grow-1" @ref="_scrollElement">
            <table class="profiler-table table table-sm table-borderless mb-0">
                <colgroup>
                    @if (ShowCommandNameColumn)
                    {
                        <col class="profiler-col-command" />
                    }
                    <col class="profiler-col-database" />
                    <col class="profiler-col-application" />
                    <col class="profiler-col-user" />
                    <col class="profiler-col-host" />
                    <col class="profiler-col-client-pid" />
                    <col class="profiler-col-duration" />
                    <col class="profiler-col-sql" />
                </colgroup>
                <thead class="profiler-table-head">
                    <tr>
                        @if (ShowCommandNameColumn)
                        {
                            <th scope="col">Command</th>
                        }
                        <th scope="col">Database</th>
                        <th scope="col">Application</th>
                        <th scope="col">User</th>
                        <th scope="col">Host</th>
                        <th scope="col">ClientProcessId</th>
                        <th scope="col">Duration</th>
                        <th scope="col">SqlText</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Items.Count; index++)
                    {
                        var item = Items[index];
                        var rowShade = index % 2 == 0 ? "profiler-row-even" : "profiler-row-odd";
                        var info = item.Captured.Info;
                        <tr class="profiler-data-row @rowShade"
                            role="button"
                            tabindex="0"
                            @onclick="() => OnSelect.InvokeAsync(item)"
                            @onkeydown="e => OnRowKeyDown(e, item)">
                            @if (ShowCommandNameColumn)
                            {
                                <td class="profiler-cell-command">@DisplayCell(GetCommandName(item))</td>
                            }
                            <td>@DisplayCell(info.DatabaseName)</td>
                            <td>@DisplayCell(info.ApplicationName)</td>
                            <td>@DisplayCell(info.UserName)</td>
                            <td>@DisplayCell(info.HostName)</td>
                            <td class="profiler-cell-numeric">@FormatClientProcessId(info.ClientProcessId)</td>
                            <td class="profiler-cell-numeric">@FormatDuration(info.DurationMicroseconds)</td>
                            <td class="profiler-cell-sql" title="@info.SqlText">@FormatSqlText(info.SqlText)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly string _autoScrollId = $"profiler-autoscroll-{Guid.NewGuid():N}";
    private ElementReference _scrollElement;
    private int _previousCount;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool ShowHeader { get; set; } = true;

    [Parameter]
    public bool ShowCommandNameColumn { get; set; }

    [Parameter, EditorRequired]
    public string ThemeClass { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProfilerLiveEventDisplay> Items { get; set; } = Array.Empty<ProfilerLiveEventDisplay>();

    [Parameter]
    public bool AutoScroll { get; set; } = true;

    [Parameter]
    public EventCallback<bool> AutoScrollChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ProfilerLiveEventDisplay> OnSelect { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Items.Count > _previousCount && AutoScroll)
        {
            await JsRuntime.InvokeVoidAsync("profiler.scrollToBottom", _scrollElement);
        }

        _previousCount = Items.Count;
    }

    private async Task OnAutoScrollChanged(ChangeEventArgs args)
    {
        var enabled = args.Value switch
        {
            bool b => b,
            string s => string.Equals(s, "true", StringComparison.OrdinalIgnoreCase),
            _ => AutoScroll,
        };
        await AutoScrollChanged.InvokeAsync(enabled);
    }

    private async Task OnRowKeyDown(KeyboardEventArgs args, ProfilerLiveEventDisplay item)
    {
        if (args.Key is "Enter" or " ")
        {
            await OnSelect.InvokeAsync(item);
        }
    }

    private static string DisplayCell(string value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatClientProcessId(int clientProcessId) =>
        clientProcessId > 0 ? clientProcessId.ToString(CultureInfo.InvariantCulture) : "—";

    private static string FormatDuration(long durationMicroseconds)
    {
        if (durationMicroseconds <= 0)
        {
            return "—";
        }

        var milliseconds = durationMicroseconds / 1000d;
        return milliseconds < 1
            ? "<1 ms"
            : $"{milliseconds.ToString("0.###", CultureInfo.InvariantCulture)} ms";
    }

    private static string FormatSqlText(string sqlText) =>
        ProfilerSqlSnippet.FormatForTile(sqlText, SqlTextMaxLength);

    private static string GetCommandName(ProfilerLiveEventDisplay item)
    {
        if (!string.IsNullOrWhiteSpace(item.Title))
        {
            return item.Title;
        }

        var lookup = item.Captured.CommandLookup;
        if (!string.IsNullOrWhiteSpace(lookup?.ObjectName))
        {
            return lookup.ObjectName;
        }

        return item.Captured.Info.ObjectName;
    }

    private const int SqlTextMaxLength = 120;
}
