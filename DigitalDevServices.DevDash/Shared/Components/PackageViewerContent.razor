@if (ScanResult is not null && ScanResult.IsSuccess)
{
    @if (ScanResult.Source == DeployedPackageSource.Manifest && !string.IsNullOrWhiteSpace(ScanResult.ManifestFileName))
    {
        <p class="text-muted small mb-2">
            Package list from <code>@ScanResult.ManifestFileName</code> in the deployment root folder.
        </p>
    }

    @if (ScanResult.Warnings.Count > 0)
    {
        <div class="alert alert-warning" role="status">
            <p class="mb-2 fw-semibold">Manifest warnings</p>
            <ul class="mb-0">
                @foreach (var warning in ScanResult.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    }
}

@if (!string.IsNullOrWhiteSpace(ScanResult?.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">@ScanResult.ErrorMessage</div>
}
else if (ScanResult?.Packages.Count == 0)
{
    <div class="alert alert-light border text-center py-4" role="status">
        <p class="mb-0 text-muted">No packages were found for this deployment.</p>
    </div>
}
else if (ScanResult is not null)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>File name</th>
                    <th>File version</th>
                    <th>Assembly version</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var package in ScanResult.Packages)
                {
                    <tr>
                        <td>
                            <code title="@package.RepresentativePath">@package.FileName</code>
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(package.FileVersion))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @package.FileVersion
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(package.AssemblyVersion))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @package.AssemblyVersion
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public DeployedPackageScanResult? ScanResult { get; set; }
}
