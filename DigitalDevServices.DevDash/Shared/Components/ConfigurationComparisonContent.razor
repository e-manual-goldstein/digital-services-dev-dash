@if (!string.IsNullOrWhiteSpace(Result?.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">@Result.ErrorMessage</div>
}
else if (Result is not null)
{
    @if (Result.Rows.Count == 0)
    {
        <div class="alert alert-light border text-center py-4" role="status">
            <p class="mb-0 text-muted">No settings have been captured for either instance yet.</p>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-8">
                        <label class="form-label" for="config-compare-search">Search settings</label>
                        <InputText id="config-compare-search"
                                   class="form-control"
                                   @bind-Value="_searchText"
                                   placeholder="Filter by key or value" />
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-check mt-lg-4">
                            <InputCheckbox id="config-compare-reveal-secrets"
                                           class="form-check-input"
                                           @bind-Value="_revealSecrets" />
                            <label class="form-check-label" for="config-compare-reveal-secrets">Show masked values</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (FilteredRows.Count == 0)
        {
            <div class="alert alert-light border" role="status">
                No settings match the current search.
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <p class="text-muted small mb-0">
                    Showing @FilteredRows.Count of @Result.Rows.Count settings
                    @if (_differenceCount > 0)
                    {
                        <span>&middot; @_differenceCount difference(s)</span>
                    }
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle package-comparison-table">
                    <thead class="table-light">
                        <tr>
                            <th>Key</th>
                            <th>@LeftColumnLabel</th>
                            <th>@RightColumnLabel</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredRows)
                        {
                            <tr class="@GetRowClass(row.Status)">
                                <td><code>@row.Key</code></td>
                                <td>@RenderValueCell(row.Key, row.LeftValue, row.LeftSource)</td>
                                <td>@RenderValueCell(row.Key, row.RightValue, row.RightSource)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    [Parameter]
    public ConfigurationComparisonResult? Result { get; set; }

    [Parameter]
    public string LeftColumnLabel { get; set; } = "Instance A";

    [Parameter]
    public string RightColumnLabel { get; set; } = "Instance B";

    private string _searchText = string.Empty;
    private bool _revealSecrets;

    private int _differenceCount =>
        Result?.Rows.Count(row => row.Status != ConfigurationComparisonStatus.Match) ?? 0;

    private IReadOnlyList<ConfigurationComparisonRow> FilteredRows
    {
        get
        {
            if (Result is null)
            {
                return [];
            }

            if (string.IsNullOrWhiteSpace(_searchText))
            {
                return Result.Rows;
            }

            var term = _searchText.Trim();
            return Result.Rows
                .Where(row =>
                    row.Key.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (row.LeftValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (row.RightValue?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (row.LeftSource?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (row.RightSource?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

    private static string GetRowClass(ConfigurationComparisonStatus status) =>
        status switch
        {
            ConfigurationComparisonStatus.Mismatch => "package-comparison-table__mismatch",
            ConfigurationComparisonStatus.LeftOnly => "package-comparison-table__left-only",
            ConfigurationComparisonStatus.RightOnly => "package-comparison-table__right-only",
            _ => string.Empty
        };

    private MarkupString RenderValueCell(string key, string? value, string? source)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new MarkupString("<span class=\"text-muted\">—</span>");
        }

        var isMasked = ConfigurationSecretMasker.ShouldMaskKey(key) && !_revealSecrets;
        var displayValue = ConfigurationSecretMasker.GetDisplayValue(key, value, _revealSecrets);
        var encodedValue = System.Net.WebUtility.HtmlEncode(displayValue);
        var sourceMarkup = string.IsNullOrWhiteSpace(source)
            ? string.Empty
            : $"<div class=\"text-muted small\">{System.Net.WebUtility.HtmlEncode(source)}</div>";
        var maskedBadge = isMasked ? "<span class=\"badge bg-secondary ms-1\">masked</span>" : string.Empty;

        return new MarkupString(
            $"<code class=\"text-break\">{encodedValue}</code>{maskedBadge}{sourceMarkup}");
    }
}
