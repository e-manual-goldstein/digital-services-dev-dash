@namespace DigitalDevServices.DevDash.Shared.Components
@using DigitalDevServices.Model.Logs

@if (IsOpen && Exception is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@_titleId"
         @ref="_modalElement"
         @onkeydown="HandleKeyDownAsync">
        <div class="modal-dialog modal-xl modal-dialog-scrollable log-exception-modal" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="@_titleId">@Title</h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    @{
                        var index = 0;
                        foreach (var item in Exception.EnumerateChain())
                        {
                            <section class="log-exception-section @(index > 0 ? "mt-4 pt-3 border-top" : null)">
                                @if (index > 0)
                                {
                                    <p class="text-muted small mb-2">Inner exception</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Type))
                                {
                                    <h6 class="log-exception-type mb-2">@item.Type</h6>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Message))
                                {
                                    <p class="log-exception-message mb-2">@item.Message</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.StackTrace))
                                {
                                    <pre class="log-exception-stack mb-0">@item.StackTrace</pre>
                                }
                            </section>
                            index++;
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" @onclick="CloseAsync"></div>
}

@code {
    private readonly string _titleId = $"exception-detail-modal-title-{Guid.NewGuid():N}";
    private ElementReference _modalElement;
    private bool _wasOpen;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public ParsedLogException? Exception { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            await _modalElement.FocusAsync();
        }

        _wasOpen = IsOpen;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
