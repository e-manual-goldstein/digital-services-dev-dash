<div class="table-responsive">
    <table class="table table-sm table-striped align-middle coverlet-summary-table">
        <colgroup>
            <col class="coverlet-summary-table__module" />
            <col class="coverlet-summary-table__count" />
            <col class="coverlet-summary-table__count" />
            <col class="coverlet-summary-table__percent" />
        </colgroup>
        <thead class="table-light">
            <tr>
                <th>Module name</th>
                <th class="text-end">Classes</th>
                <th class="text-end">Methods</th>
                <th class="text-end">Line coverage</th>
            </tr>
        </thead>
        <tbody>
            @if (ModuleSummaries.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted text-center py-3">No modules with visible method rows.</td>
                </tr>
            }
            else
            {
                @foreach (var row in ModuleSummaries)
                {
                    <tr>
                        <td><code class="coverlet-cell-truncate" title="@row.ModuleName">@row.ModuleName</code></td>
                        <td class="text-end">@row.ClassCount</td>
                        <td class="text-end">@row.MethodCount</td>
                        <td class="text-end text-nowrap">@FormatPercent(row.LineCoveragePercent)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<CoverletCoverageRow> Rows { get; set; } = [];

    [Parameter]
    public IReadOnlySet<string> HiddenRowKeys { get; set; } = new HashSet<string>(StringComparer.Ordinal);

    private IReadOnlyList<CoverletModuleSummaryRow> ModuleSummaries =>
        CoverletCoverageSummaryBuilder.BuildModuleSummaries(Rows, HiddenRowKeys);

    private static string FormatPercent(decimal value) => $"{value:0.##}%";
}
