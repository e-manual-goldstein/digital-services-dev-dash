@namespace DigitalDevServices.DevDash.Shared.Components
@inject ProfilerDashboardService ProfilerState
@using DigitalDevServices.DevDash.Services

@if (IsOpen)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@_titleId"
         @ref="_modalElement"
         @onkeydown="HandleKeyDownAsync">
        <div class="modal-dialog modal-dialog-scrollable modal-xl" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="@_titleId">Group summary</h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="@_dimensionId">Group by</label>
                        <select id="@_dimensionId"
                                class="form-select form-select-sm profiler-group-summary-dimension"
                                @bind="_dimension">
                            @foreach (var dimension in _dimensions)
                            {
                                <option value="@dimension">
                                    @ProfilerGroupSummaryDimensionLabels.GetDropdownLabel(dimension)
                                </option>
                            }
                        </select>
                    </div>

                    @if (Rows.Count == 0)
                    {
                        <p class="text-muted mb-0">No events captured in this session yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-bordered mb-0 profiler-group-summary-table">
                                <thead>
                                    <tr>
                                        <th scope="col">@GroupColumnHeader</th>
                                        <th scope="col" class="text-end">EF Inserts</th>
                                        <th scope="col" class="text-end">EF Updates</th>
                                        <th scope="col" class="text-end">EF Deletes</th>
                                        <th scope="col" class="text-end">EF Read-Only</th>
                                        <th scope="col" class="text-end">Recognised</th>
                                        <th scope="col" class="text-end">Unknown</th>
                                        <th scope="col" class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Rows)
                                    {
                                        <tr>
                                            <td>@row.GroupKey</td>
                                            <td class="text-end">@row.InsertCount</td>
                                            <td class="text-end">@row.UpdateCount</td>
                                            <td class="text-end">@row.DeleteCount</td>
                                            <td class="text-end">@row.ReadOnlyCount</td>
                                            <td class="text-end">@row.RecognisedCount</td>
                                            <td class="text-end">@row.UnknownCount</td>
                                            <td class="text-end fw-semibold">@row.TotalCount</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-secondary fw-semibold">
                                        <td>Total</td>
                                        <td class="text-end">@Totals.InsertCount</td>
                                        <td class="text-end">@Totals.UpdateCount</td>
                                        <td class="text-end">@Totals.DeleteCount</td>
                                        <td class="text-end">@Totals.ReadOnlyCount</td>
                                        <td class="text-end">@Totals.RecognisedCount</td>
                                        <td class="text-end">@Totals.UnknownCount</td>
                                        <td class="text-end">@Totals.TotalCount</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" @onclick="CloseAsync"></div>
}

@code {
    private readonly string _titleId = $"profiler-group-summary-title-{Guid.NewGuid():N}";
    private readonly string _dimensionId = $"profiler-group-summary-dimension-{Guid.NewGuid():N}";
    private static readonly ProfilerGroupSummaryDimension[] _dimensions =
        Enum.GetValues<ProfilerGroupSummaryDimension>();

    private ElementReference _modalElement;
    private bool _wasOpen;
    private ProfilerGroupSummaryDimension _dimension = ProfilerGroupSummaryDimension.HostName;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private IReadOnlyList<ProfilerGroupSummaryRow> Rows =>
        IsOpen ? ProfilerState.GetGroupSummary(_dimension) : [];

    private string GroupColumnHeader =>
        ProfilerGroupSummaryDimensionLabels.GetColumnHeader(_dimension);

    private ProfilerGroupSummaryRow Totals
    {
        get
        {
            var rows = Rows;
            return new ProfilerGroupSummaryRow
            {
                GroupKey = "Total",
                InsertCount = rows.Sum(row => row.InsertCount),
                UpdateCount = rows.Sum(row => row.UpdateCount),
                DeleteCount = rows.Sum(row => row.DeleteCount),
                ReadOnlyCount = rows.Sum(row => row.ReadOnlyCount),
                RecognisedCount = rows.Sum(row => row.RecognisedCount),
                UnknownCount = rows.Sum(row => row.UnknownCount),
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            await _modalElement.FocusAsync();
        }

        _wasOpen = IsOpen;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
