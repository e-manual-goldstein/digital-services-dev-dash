@page "/applications"
@using DigitalDevServices.Model.Applications
@inject IDeployableApplicationService ApplicationService
@inject IApplicationInstanceService InstanceService
@inject ILogFormatProfileService LogFormatProfileService
@inject ILogParsingService LogParsingService
@inject ILogPathTemplateService LogPathTemplateService
@inject IRegistrationPrefillState RegistrationPrefillState
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>Applications</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
        <h1 class="mb-1">Applications</h1>
        <p class="text-muted mb-0">Deployable projects that can be installed into environments.</p>
    </div>
    @if (!_isFormVisible)
    {
        <button type="button"
                class="btn btn-primary"
                disabled="@_isBusy"
                @onclick="ShowCreateForm">
            Add application
        </button>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_isFormVisible)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">@(_editingId is null ? "Add application" : "Edit application")</h2>
            <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="app-name">Name</label>
                        <InputText id="app-name"
                                   class="form-control"
                                   @bind-Value="_formModel.Name"
                                   disabled="@_isBusy" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="app-project-key">Project key</label>
                        <InputText id="app-project-key"
                                   class="form-control"
                                   @bind-Value="_formModel.ProjectKey"
                                   disabled="@_isBusy" />
                        <div class="form-text">Optional repo or project identifier.</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox id="app-is-web-app"
                                           class="form-check-input"
                                           @bind-Value="_formModel.IsWebApp"
                                           disabled="@_isBusy" />
                            <label class="form-check-label" for="app-is-web-app">Web application</label>
                        </div>
                        <div class="form-text">Enable when this app has a browser homepage in deployed environments.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="app-log-format">Log format</label>
                        <InputSelect id="app-log-format"
                                     class="form-select"
                                     @bind-Value="_formModel.LogFormatName"
                                     disabled="@_isBusy">
                            <option value="">(None)</option>
                            @foreach (var formatName in _supportedLogFormats)
                            {
                                <option value="@formatName">@LogFormatNames.GetDisplayName(formatName)</option>
                            }
                        </InputSelect>
                        <div class="form-text">How log files for this application are parsed in the log viewer.</div>
                    </div>
                    @if (IsCustomRegexFormatSelected)
                    {
                        <div class="col-12">
                            <label class="form-label" for="app-custom-regex-mode">Custom regex mode</label>
                            <InputSelect id="app-custom-regex-mode"
                                         class="form-select"
                                         @bind-Value="_formModel.CustomRegexMode"
                                         disabled="@_isBusy">
                                <option value="@CustomRegexParserConfig.ModeEntry">Entry (one line per match)</option>
                                <option value="@CustomRegexParserConfig.ModeEntryStart">EntryStart (multiline entries)</option>
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="app-custom-regex-pattern">Pattern</label>
                            <InputTextArea id="app-custom-regex-pattern"
                                           class="form-control font-monospace"
                                           rows="4"
                                           @bind-Value="_formModel.CustomRegexPattern"
                                           disabled="@_isBusy" />
                            <div class="form-text">
                                .NET regex with named groups: <code>message</code> (required), optional <code>timestamp</code>, <code>level</code>, and any others → properties.
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="app-custom-regex-timestamp-format">Timestamp format</label>
                            <InputText id="app-custom-regex-timestamp-format"
                                       class="form-control font-monospace"
                                       @bind-Value="_formModel.CustomRegexTimestampFormat"
                                       disabled="@_isBusy" />
                            <div class="form-text">Optional <code>DateTimeOffset.TryParseExact</code> format when the pattern captures <code>timestamp</code>.</div>
                        </div>
                    }
                    <div class="col-12">
                        <label class="form-label" for="app-log-format-notes">Log format notes</label>
                        <InputTextArea id="app-log-format-notes"
                                       class="form-control"
                                       rows="2"
                                       @bind-Value="_formModel.LogFormatNotes"
                                       disabled="@_isBusy" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="app-path-to-physical-path">Path to physical path</label>
                        <InputText id="app-path-to-physical-path"
                                   class="form-control font-monospace"
                                   @bind-Value="_formModel.PathToPhysicalPath"
                                   disabled="@_isBusy" />
                        <div class="form-text">
                            Optional template resolved per deployment. Tokens:
                            @string.Join(", ", LogPathTemplateTokens.All.Select(token => $"{{{token}}}")).
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_formModel.PathToPhysicalPath))
                        {
                            <div class="form-text">
                                Example:
                                <code>@GetSamplePhysicalPathPreview()</code>
                            </div>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="app-path-to-log-files">Path to log files</label>
                        <InputText id="app-path-to-log-files"
                                   class="form-control font-monospace"
                                   @bind-Value="_formModel.PathToLogFiles"
                                   disabled="@_isBusy" />
                        <div class="form-text">
                            Optional template resolved per deployment. Tokens:
                            @string.Join(", ", LogPathTemplateTokens.All.Select(token => $"{{{token}}}")).
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_formModel.PathToLogFiles))
                        {
                            <div class="form-text">
                                Example:
                                <code>@GetSampleLogPathPreview()</code>
                            </div>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="app-notes">Notes</label>
                        <InputTextArea id="app-notes"
                                       class="form-control"
                                       rows="3"
                                       @bind-Value="_formModel.Notes"
                                       disabled="@_isBusy" />
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                        @(_isSaving ? "Saving…" : "Save")
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@_isBusy"
                            @onclick="CancelForm">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_isLoading)
{
    <p class="text-muted">Loading applications…</p>
}
else if (_applications.Count == 0)
{
    <div class="alert alert-light border text-center py-5" role="status">
        <p class="mb-3 text-muted">No deployable applications registered yet.</p>
        @if (!_isFormVisible)
        {
            <button type="button" class="btn btn-primary" @onclick="ShowCreateForm">
                Add your first application
            </button>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Log format</th>
                    <th>Project key</th>
                    <th>Notes</th>
                    <th>Created</th>
                    <th style="width: 11rem;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in _applications)
                {
                    var hasInstances = _applicationIdsWithInstances.Contains(application.Id);
                    var isDeleting = _deletingId == application.Id;
                    <tr>
                        <td>@application.Name</td>
                        <td>
                            @if (application.IsWebApp)
                            {
                                <span class="badge bg-primary">Web</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (_logFormatsByApplicationId.TryGetValue(application.Id, out var formatName))
                            {
                                <span class="badge bg-secondary">@LogFormatNames.GetDisplayName(formatName)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(application.ProjectKey))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <code>@application.ProjectKey</code>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(application.Notes))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @application.Notes
                            }
                        </td>
                        <td>@application.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        disabled="@(_isBusy || isDeleting)"
                                        @onclick="() => ShowEditForm(application)">
                                    Edit
                                </button>
                                @if (isDeleting)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@_isBusy"
                                            @onclick="() => ConfirmDeleteAsync(application.Id)">
                                        Confirm
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled="@_isBusy"
                                            @onclick="CancelDelete">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled="@(_isBusy || hasInstances)"
                                            title="@(hasInstances ? "Remove deployments before deleting this application." : "Delete application")"
                                            @onclick="() => PromptDelete(application.Id)">
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<DeployableApplication> _applications = [];
    private Dictionary<Guid, string> _logFormatsByApplicationId = [];
    private IReadOnlyList<string> _supportedLogFormats = [];
    private HashSet<Guid> _applicationIdsWithInstances = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isSaving;
    private bool _isFormVisible;
    private Guid? _editingId;
    private Guid? _deletingId;
    private string? _errorMessage;
    private ApplicationFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        _supportedLogFormats = LogParsingService.GetSupportedFormatNames();
        await LoadAsync();
        ApplyApplicationPrefillIfPresent();
    }

    private async Task LoadAsync()
    {
        _errorMessage = null;
        _isLoading = _applications.Count == 0;

        try
        {
            _applications = await ApplicationService.GetAllAsync();
            var profiles = await LogFormatProfileService.GetAllAsync();
            _logFormatsByApplicationId = profiles.ToDictionary(
                profile => profile.DeployableApplicationId,
                profile => profile.FormatName);
            var instances = await InstanceService.GetAllAsync();
            _applicationIdsWithInstances = instances
                .Select(instance => instance.DeployableApplicationId)
                .ToHashSet();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load applications: {ex.Message}";
            _applications = [];
            _logFormatsByApplicationId = [];
            _applicationIdsWithInstances = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyApplicationPrefillIfPresent()
    {
        var prefill = RegistrationPrefillState.Current;
        if (prefill?.RequiresApplicationCreate != true || prefill.Application is null)
        {
            return;
        }

        _errorMessage = null;
        _editingId = null;
        _deletingId = null;
        _formModel = new ApplicationFormModel
        {
            Name = prefill.Application.Name,
            IsWebApp = prefill.Application.IsWebApp,
            PathToLogFiles = prefill.Application.PathToLogFiles ?? string.Empty,
            PathToPhysicalPath = prefill.Application.PathToPhysicalPath ?? string.Empty
        };
        _isFormVisible = true;
    }

    private void ShowCreateForm()
    {
        _errorMessage = null;
        _editingId = null;
        _formModel = new ApplicationFormModel();
        _isFormVisible = true;
        _deletingId = null;
    }

    private async Task ShowEditForm(DeployableApplication application)
    {
        _errorMessage = null;
        _editingId = application.Id;
        var profile = await LogFormatProfileService.GetByDeployableApplicationIdAsync(application.Id);
        _formModel = new ApplicationFormModel
        {
            Name = application.Name,
            ProjectKey = application.ProjectKey ?? string.Empty,
            IsWebApp = application.IsWebApp,
            Notes = application.Notes ?? string.Empty,
            PathToLogFiles = application.PathToLogFiles ?? string.Empty,
            PathToPhysicalPath = application.PathToPhysicalPath ?? string.Empty,
            LogFormatName = profile?.FormatName ?? string.Empty,
            LogFormatNotes = profile?.Notes ?? string.Empty
        };

        if (string.Equals(profile?.FormatName, LogFormatNames.CustomRegex, StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                var customConfig = CustomRegexParserConfig.Parse(profile!.ParserConfig);
                _formModel.CustomRegexMode = customConfig.Mode;
                _formModel.CustomRegexPattern = customConfig.Pattern;
                _formModel.CustomRegexTimestampFormat = customConfig.TimestampFormat ?? string.Empty;
            }
            catch (InvalidOperationException)
            {
                _formModel.CustomRegexMode = CustomRegexParserConfig.ModeEntry;
            }
        }

        _isFormVisible = true;
        _deletingId = null;
    }

    private void CancelForm()
    {
        if (RegistrationPrefillState.Current?.RequiresApplicationCreate == true)
        {
            RegistrationPrefillState.Clear();
        }

        _isFormVisible = false;
        _editingId = null;
        _formModel = new ApplicationFormModel();
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        _isSaving = true;

        try
        {
            var name = _formModel.Name.Trim();
            var projectKey = NormalizeOptional(_formModel.ProjectKey);
            var notes = NormalizeOptional(_formModel.Notes);
            var pathToLogFiles = NormalizeOptional(_formModel.PathToLogFiles);
            var pathToPhysicalPath = NormalizeOptional(_formModel.PathToPhysicalPath);

            if (_editingId is null)
            {
                var created = await ApplicationService.CreateAsync(
                    name,
                    projectKey,
                    notes,
                    _formModel.IsWebApp,
                    pathToLogFiles,
                    pathToPhysicalPath);
                await SaveLogFormatProfileAsync(created.Id);

                var pendingRegistration = RegistrationPrefillState.Current;
                if (pendingRegistration?.RequiresApplicationCreate == true)
                {
                    RegistrationPrefillState.Set(
                        pendingRegistration.ContinueAfterApplicationCreated(created.Id));
                    _isFormVisible = false;
                    _editingId = null;
                    _formModel = new ApplicationFormModel();
                    Navigation.NavigateTo($"/environments/{pendingRegistration.EnvironmentLocalId}");
                    return;
                }

                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Application created",
                    Detail = $"{name} was added.",
                    Duration = 4000
                });
            }
            else
            {
                await ApplicationService.UpdateAsync(
                    _editingId.Value,
                    name,
                    projectKey,
                    notes,
                    _formModel.IsWebApp,
                    pathToLogFiles,
                    pathToPhysicalPath);
                await SaveLogFormatProfileAsync(_editingId.Value);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Application updated",
                    Detail = $"{name} was saved.",
                    Duration = 4000
                });
            }

            CancelForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
            _isBusy = false;
        }
    }

    private void PromptDelete(Guid id)
    {
        _errorMessage = null;
        _deletingId = id;
        _isFormVisible = false;
    }

    private void CancelDelete()
    {
        _deletingId = null;
    }

    private async Task ConfirmDeleteAsync(Guid id)
    {
        _errorMessage = null;
        _isBusy = true;

        try
        {
            await ApplicationService.DeleteAsync(id);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Application deleted",
                Duration = 4000
            });
            _deletingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SaveLogFormatProfileAsync(Guid deployableApplicationId)
    {
        var formatName = _formModel.LogFormatName.Trim();
        if (string.IsNullOrWhiteSpace(formatName))
        {
            await LogFormatProfileService.DeleteByDeployableApplicationIdAsync(deployableApplicationId);
            return;
        }

        await LogFormatProfileService.UpsertAsync(new LogFormatProfileUpsert
        {
            DeployableApplicationId = deployableApplicationId,
            FormatName = formatName,
            ParserConfig = BuildParserConfigJson(formatName),
            Notes = NormalizeOptional(_formModel.LogFormatNotes)
        });
    }

    private string? BuildParserConfigJson(string formatName)
    {
        if (!string.Equals(formatName, LogFormatNames.CustomRegex, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return new CustomRegexParserConfig
        {
            Mode = _formModel.CustomRegexMode,
            Pattern = _formModel.CustomRegexPattern.Trim(),
            TimestampFormat = NormalizeOptional(_formModel.CustomRegexTimestampFormat)
        }.ToJson();
    }

    private bool IsCustomRegexFormatSelected =>
        string.Equals(_formModel.LogFormatName, LogFormatNames.CustomRegex, StringComparison.OrdinalIgnoreCase);

    private string GetSampleLogPathPreview() => GetSampleTemplatePreview(_formModel.PathToLogFiles);

    private string GetSamplePhysicalPathPreview() => GetSampleTemplatePreview(_formModel.PathToPhysicalPath);

    private string GetSampleTemplatePreview(string template)
    {
        var appName = string.IsNullOrWhiteSpace(_formModel.Name)
            ? "portal"
            : _formModel.Name.Trim();

        return LogPathTemplateService.Resolve(
            template,
            new LogPathTemplateContext
            {
                MachineName = "UAT-01-APP",
                EnvironmentCode = "UAT-01",
                EnvironmentName = "UAT-01",
                AppName = appName,
                VirtualPath = "/portal",
                PhysicalPath = @"C:\inetpub\wwwroot\portal"
            }).ResolvedPath;
    }

    private static string? NormalizeOptional(string value)
    {
        var trimmed = value.Trim();
        return trimmed.Length == 0 ? null : trimmed;
    }

    private sealed class ApplicationFormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [StringLength(200, ErrorMessage = "Name must be 200 characters or fewer.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(200, ErrorMessage = "Project key must be 200 characters or fewer.")]
        public string ProjectKey { get; set; } = string.Empty;

        public bool IsWebApp { get; set; }

        public string LogFormatName { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Log format notes must be 2000 characters or fewer.")]
        public string LogFormatNotes { get; set; } = string.Empty;

        public string CustomRegexMode { get; set; } = CustomRegexParserConfig.ModeEntry;

        public string CustomRegexPattern { get; set; } = string.Empty;

        public string CustomRegexTimestampFormat { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Path to log files must be 2000 characters or fewer.")]
        public string PathToLogFiles { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Path to physical path must be 2000 characters or fewer.")]
        public string PathToPhysicalPath { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Notes must be 2000 characters or fewer.")]
        public string Notes { get; set; } = string.Empty;
    }
}
