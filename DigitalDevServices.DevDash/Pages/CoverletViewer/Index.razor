@page "/coverlet-viewer"
@inject ICoverletCoverageReportParser CoverageReportParser
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Coverlet Viewer</PageTitle>

<h1 class="mb-1">Coverlet Viewer</h1>
<p class="text-muted mb-4">
    Upload a Coverlet code-coverage JSON report, filter and hide noise, then export a smaller JSON working set for downstream tasks.
    Files are parsed in your session only — nothing is saved on the server.
</p>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <label class="form-label" for="coverlet-upload">Coverage report (JSON)</label>
        <InputFile id="coverlet-upload"
                   class="form-control"
                   accept=".json,application/json"
                   OnChange="OnFileSelectedAsync"
                   disabled="@_isLoading" />
        <p class="form-text text-muted mb-0">
            Standard Coverlet JSON — summary format (<code>Classes</code> / <code>Methods</code>) or legacy format (module → file → type → method with <code>Lines</code> / <code>Branches</code>).
            @if (!string.IsNullOrWhiteSpace(_loadedFileName))
            {
                <span>Loaded: <strong>@_loadedFileName</strong>.</span>
            }
        </p>
    </div>
</div>

@if (_isLoading)
{
    <p class="text-muted">Parsing coverage report…</p>
}
else if (_parseResult is { IsSuccess: true } result)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">Run summary</h2>
            <div class="row g-4">
                <div class="col-md-6">
                    <h3 class="h6 text-muted mb-2">Overall</h3>
                    <CoverletCoverageSummaryStats Summary="@GetOverallSummary(result)" />
                    <p class="text-muted small mb-0 mt-2">@result.Rows.Count method row(s) in upload.</p>
                </div>
                <div class="col-md-6 border-start ps-md-4">
                    <h3 class="h6 text-muted mb-2">Filtered</h3>
                    <CoverletCoverageSummaryStats Summary="@GetFilteredSummary(result.Rows)" />
                    <p class="text-muted small mb-0 mt-2">
                        @GetFilteredExportRowCount(result.Rows) method row(s) after column filters; hidden rows excluded.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <CollapsibleSection Title="@GetModulesSummaryTitle()"
                            DefaultExpanded="false"
                            IsEmpty="@(result.Rows.Count == 0)">
            <CoverletCoverageModulesSummaryTable Rows="result.Rows"
                                                 HiddenRowKeys="_hiddenRowKeys"
                                                 HiddenRowKeysChanged="OnHiddenRowKeysChanged"
                                                 SelectedModuleNames="_selectedModuleNames"
                                                 SelectedModuleNamesChanged="OnSelectedModuleNamesChanged" />
        </CollapsibleSection>
    </div>

    <div class="mb-4">
        <CollapsibleSection Title="Class summary"
                            DefaultExpanded="false"
                            IsEmpty="@(result.Rows.Count == 0)">
            <CoverletCoverageClassSummaryTable Rows="result.Rows"
                                               HiddenRowKeys="_hiddenRowKeys" />
        </CollapsibleSection>
    </div>

    <div class="mb-4">
        <CollapsibleSection Title="@GetResultsSectionTitle(result.Rows.Count)"
                            DefaultExpanded="true"
                            IsEmpty="@(result.Rows.Count == 0)">
            <CoverletCoverageResultsTable Rows="result.Rows"
                                           SourceFileName="_loadedFileName"
                                           SelectedRowKeys="_selectedRowKeys"
                                           SelectedRowKeysChanged="OnSelectedRowKeysChanged"
                                           HiddenRowKeys="_hiddenRowKeys"
                                           HiddenRowKeysChanged="OnHiddenRowKeysChanged"
                                           ShowHidden="_showHidden"
                                           ShowHiddenChanged="OnShowHiddenChanged"
                                           FiltersChanged="OnTableFiltersChanged" />
        </CollapsibleSection>
    </div>
}
else
{
    <div class="alert alert-light border" role="status">
        <p class="mb-0 text-muted">Choose a JSON file above to load coverage results.</p>
    </div>
}

@code {
    private const long MaxUploadBytes = 50 * 1024 * 1024;

    private CoverletCoverageParseResult? _parseResult;
    private string? _loadedFileName;
    private string? _errorMessage;
    private bool _isLoading;
    private HashSet<string> _selectedRowKeys = new(StringComparer.Ordinal);
    private HashSet<string> _selectedModuleNames = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _hiddenRowKeys = new(StringComparer.Ordinal);
    private bool _showHidden;
    private CoverletCoverageFilterState _tableFilters = new();

    private Task OnSelectedRowKeysChanged(IReadOnlySet<string> selectedRowKeys)
    {
        _selectedRowKeys = new HashSet<string>(selectedRowKeys, StringComparer.Ordinal);
        return Task.CompletedTask;
    }

    private Task OnSelectedModuleNamesChanged(IReadOnlySet<string> selectedModuleNames)
    {
        _selectedModuleNames = new HashSet<string>(selectedModuleNames, StringComparer.OrdinalIgnoreCase);
        return Task.CompletedTask;
    }

    private Task OnHiddenRowKeysChanged(IReadOnlySet<string> hiddenRowKeys)
    {
        _hiddenRowKeys = new HashSet<string>(hiddenRowKeys, StringComparer.Ordinal);
        return InvokeAsync(StateHasChanged);
    }

    private Task OnTableFiltersChanged(CoverletCoverageFilterState filters)
    {
        _tableFilters = filters;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnShowHiddenChanged(bool showHidden)
    {
        _showHidden = showHidden;
        return Task.CompletedTask;
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _errorMessage = null;
        _parseResult = null;
        _loadedFileName = null;
        _selectedRowKeys.Clear();
        _selectedModuleNames.Clear();
        _hiddenRowKeys.Clear();
        _showHidden = false;
        _tableFilters = new CoverletCoverageFilterState();

        var file = args.File;
        if (file.Size == 0)
        {
            _errorMessage = "The file is empty.";
            return;
        }

        if (file.Size > MaxUploadBytes)
        {
            _errorMessage = $"The file is too large (max {MaxUploadBytes / (1024 * 1024)} MB).";
            return;
        }

        _isLoading = true;

        try
        {
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            _parseResult = CoverageReportParser.Parse(json);

            if (!_parseResult.IsSuccess)
            {
                _errorMessage = _parseResult.ErrorMessage;
                _parseResult = null;
                return;
            }

            _loadedFileName = file.Name;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not read the file: {ex.Message}";
            _parseResult = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private CoverletCoverageSummary GetOverallSummary(CoverletCoverageParseResult result) =>
        result.Summary ?? CoverletCoverageSummaryCalculator.BuildFromRows(result.Rows);

    private CoverletCoverageSummary GetFilteredSummary(IReadOnlyList<CoverletCoverageRow> rows)
    {
        var exportRows = CoverletCoverageExportBuilder.SelectRowsForExport(rows, _tableFilters, _hiddenRowKeys);
        return CoverletCoverageSummaryCalculator.BuildFromRows(exportRows);
    }

    private int GetFilteredExportRowCount(IReadOnlyList<CoverletCoverageRow> rows) =>
        CoverletCoverageExportBuilder.SelectRowsForExport(rows, _tableFilters, _hiddenRowKeys).Count;

    private string GetModulesSummaryTitle()
    {
        var moduleCount = CoverletCoverageSummaryBuilder
            .BuildModuleSummaries(_parseResult?.Rows ?? [], _hiddenRowKeys)
            .Count;
        return $"Modules summary ({moduleCount})";
    }

    private static string GetResultsSectionTitle(int rowCount) => $"Method results ({rowCount})";
}
