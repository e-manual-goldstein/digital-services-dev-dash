@page "/package-viewer/compare/{LeftInstanceId:guid}/{RightInstanceId:guid}"
@inject IDeployedPackageService PackageService
@inject IApplicationInstanceService InstanceService
@inject IEnvironmentService EnvironmentService

<PageTitle>@_pageTitle</PageTitle>

<div class="mb-3">
    <a href="/package-viewer/compare" class="text-decoration-none">&larr; Back to compare</a>
</div>

@if (_isLoading)
{
    <p class="text-muted">Comparing packages…</p>
}
else
{
    <div class="mb-3">
        <h1 class="mb-1">Compare packages</h1>
        @if (!string.IsNullOrWhiteSpace(_applicationName))
        {
            <p class="text-muted mb-0">@_applicationName</p>
        }
    </div>

    <PackageViewerComparisonContent Result="_comparison"
                                    LeftColumnLabel="@_leftColumnLabel"
                                    RightColumnLabel="@_rightColumnLabel" />
}

@code {
    [Parameter]
    public Guid LeftInstanceId { get; set; }

    [Parameter]
    public Guid RightInstanceId { get; set; }

    private DeployedPackageComparisonResult? _comparison;
    private bool _isLoading = true;
    private string _pageTitle = "Compare packages";
    private string _applicationName = string.Empty;
    private string _leftColumnLabel = "Instance A";
    private string _rightColumnLabel = "Instance B";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _comparison = null;
        _applicationName = string.Empty;
        _leftColumnLabel = "Instance A";
        _rightColumnLabel = "Instance B";

        try
        {
            _comparison = await PackageService.CompareInstancesAsync(LeftInstanceId, RightInstanceId);

            var leftInstance = await InstanceService.GetByIdAsync(LeftInstanceId);
            var rightInstance = await InstanceService.GetByIdAsync(RightInstanceId);
            var environments = await EnvironmentService.GetEnvironmentsAsync();
            var environmentsById = environments.ToDictionary(environment => environment.LocalId);

            if (leftInstance is not null)
            {
                _applicationName = leftInstance.DeployableApplication.Name;
                _pageTitle = $"Compare packages — {_applicationName}";
                _leftColumnLabel = FormatInstanceLabel(leftInstance, environmentsById);
            }

            if (rightInstance is not null)
            {
                _rightColumnLabel = FormatInstanceLabel(rightInstance, environmentsById);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatInstanceLabel(
        ApplicationInstance instance,
        IReadOnlyDictionary<Guid, CachedEnvironment> environmentsById)
    {
        if (environmentsById.TryGetValue(instance.EnvironmentId, out var environment))
        {
            return EnvironmentPickerDisplay.FormatOptionLabel(environment);
        }

        return $"Environment {instance.Environment.RemoteId}";
    }
}
