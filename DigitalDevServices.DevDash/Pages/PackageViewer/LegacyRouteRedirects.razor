@page "/packages"
@page "/packages/{InstanceId:guid}"
@page "/environments/{LocalId:guid}/instances/{InstanceId:guid}/packages"
@inject NavigationManager Navigation

@code {
    [Parameter]
    public Guid LocalId { get; set; }

    [Parameter]
    public Guid InstanceId { get; set; }

    protected override void OnInitialized()
    {
        if (InstanceId == Guid.Empty)
        {
            Navigation.NavigateTo("/package-viewer", replace: true);
            return;
        }

        Navigation.NavigateTo($"/package-viewer/{InstanceId}", replace: true);
    }
}
