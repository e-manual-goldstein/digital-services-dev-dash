@namespace DigitalDevServices.DevDash.Pages.Environments
@inject IRemoteEnvironmentRegistrationMapper RegistrationMapper
@inject IRegistrationPrefillState RegistrationPrefillState
@inject NavigationManager Navigation

<EnvironmentDetailsCollectionSection Title="Environment URLs" Items="EnvironmentUrls">
    <HeaderContent>
        <tr>
            <th>Application name</th>
            <th>URL</th>
            <th style="width: 9rem;"></th>
        </tr>
    </HeaderContent>
    <RowTemplate Context="environmentUrl">
        <tr>
            <td>@environmentUrl.ApplicationName</td>
            <td>
                <a href="@environmentUrl.Url"
                   target="_blank"
                   rel="noopener noreferrer">@environmentUrl.Url</a>
            </td>
            <td>
                <div class="d-flex align-items-center gap-2">
                    @if (IsRegistered(environmentUrl))
                    {
                        <span class="badge text-bg-success">Registered</span>
                    }
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@IsBusy"
                            @onclick="() => BeginRegistrationAsync(environmentUrl)">
                        @(IsRegistered(environmentUrl) ? "Update" : "Register")
                    </button>
                </div>
            </td>
        </tr>
    </RowTemplate>
</EnvironmentDetailsCollectionSection>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<EnvironmentUrl> EnvironmentUrls { get; set; } = [];

    [Parameter, EditorRequired]
    public RemoteEnvironmentDetails EnvironmentDetails { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid EnvironmentId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ApplicationInstance> Instances { get; set; } = [];

    [Parameter]
    public RemoteEnvironmentDeploymentDetails? DeploymentDetails { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<RemoteRegistrationPrefill> OnRegistrationRequested { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private bool IsRegistered(EnvironmentUrl environmentUrl) =>
        Instances.Any(instance =>
            instance.DeployableApplication.Name.Equals(
                environmentUrl.ApplicationName,
                StringComparison.OrdinalIgnoreCase));

    private async Task BeginRegistrationAsync(EnvironmentUrl environmentUrl)
    {
        var prefill = await RegistrationMapper.BuildFromEnvironmentUrlAsync(
            EnvironmentId,
            EnvironmentDetails,
            environmentUrl,
            DeploymentDetails);

        if (prefill.RequiresApplicationCreate)
        {
            RegistrationPrefillState.Set(prefill);
            Navigation.NavigateTo("/applications");
            return;
        }

        await OnRegistrationRequested.InvokeAsync(prefill);
    }
}
