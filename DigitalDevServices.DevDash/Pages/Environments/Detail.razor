@page "/environments/{LocalId:guid}"
@inject IEnvironmentService EnvironmentService
@inject IApplicationInstanceService InstanceService
@inject IDeployableApplicationService DeployableApplicationService
@inject IPipelineFeedService PipelineFeedService
@inject NotificationService NotificationService
@inject IOptions<TfsOptions> TfsOptions
@inject IJSRuntime JsRuntime
@inject IRegistrationPrefillState RegistrationPrefillState
@inject IRemoteEnvironmentRegistrationMapper RegistrationMapper

<PageTitle>@(_environment?.Details.Name ?? "Environment")</PageTitle>

<div class="mb-3">
    <a href="/environments" class="text-decoration-none">&larr; Back to environments</a>
</div>

@if (_isLoading)
{
    <p class="text-muted">Loading environment…</p>
}
else if (_environment is null)
{
    <div class="alert alert-warning" role="alert">
        Environment not found. It may have been removed or the link is invalid.
    </div>
}
else
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h1 class="mb-1">@_environment.Details.Name</h1>
            <p class="text-muted mb-0">@_environment.Details.Code &middot; @_environment.Details.EnvironmentType</p>
        </div>
        <button type="button"
                class="btn btn-outline-secondary"
                disabled="@_isBusy"
                @onclick="RefreshAsync">
            @(_isRefreshing ? "Refreshing…" : "Refresh")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (_environment.IsFromCache && !_environment.HasRefreshSnapshot)
    {
        <p class="text-muted small mb-3">Showing cached data. Use Refresh to fetch the latest from the API.</p>
    }

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Last refreshed</dt>
                <dd class="col-sm-9">
                    @if (_environment.HasRefreshSnapshot)
                    {
                        <span>@_environment.DateLastRefreshed.ToLocalTime().ToString("g")</span>
                    }
                    else
                    {
                        <span class="text-muted">Not refreshed yet — use Refresh to load deployment details.</span>
                    }
                </dd>

                <dt class="col-sm-3">Last updated</dt>
                <dd class="col-sm-9">@_environment.DateLastUpdated.ToLocalTime().ToString("g")</dd>

                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9"><code>@_environment.Details.Code</code></dd>

                <dt class="col-sm-3">Environment type</dt>
                <dd class="col-sm-9">@_environment.Details.EnvironmentType</dd>

                <dt class="col-sm-3">Remote id</dt>
                <dd class="col-sm-9">@_environment.Details.Id</dd>

                @if (_environment.Details.TryGetAdditionalString("SqlServerInstance", out var sqlServerInstance)
                     && !string.IsNullOrWhiteSpace(sqlServerInstance))
                {
                    <dt class="col-sm-3">SQL Server instance</dt>
                    <dd class="col-sm-9">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <code>@sqlServerInstance</code>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    disabled="@_isBusy"
                                    @onclick="() => CopySqlServerInstanceAsync(sqlServerInstance)">
                                Copy
                            </button>
                        </div>
                    </dd>
                }

                @if (GetPrimaryBuildNumberText() is { } primaryBuildNumber)
                {
                    <dt class="col-sm-3">Build number</dt>
                    <dd class="col-sm-9">
                        @if (GetPrimaryBuildWorkItemUrl(primaryBuildNumber) is { } workItemUrl)
                        {
                            <a href="@workItemUrl" target="_blank" rel="noopener noreferrer">@primaryBuildNumber</a>
                        }
                        else
                        {
                            <code>@primaryBuildNumber</code>
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(GetPrimaryWipBranch()))
                {
                    <dt class="col-sm-3">WIP branch</dt>
                    <dd class="col-sm-9"><code>@GetPrimaryWipBranch()</code></dd>
                }
            </dl>
        </div>
    </div>

    <EnvironmentDeploymentBuildsSection DeploymentDetails="_environment.DeploymentDetails"
                                        WorkItemUrlTemplate="@TfsOptions.Value.WorkItemUrlTemplate" />

    @if (_environment.Details.HasAdditionalProperties)
    {
        <div class="card mt-3">
            <div class="card-body">
                <CollapsibleSection Title="Additional properties">
                    <pre class="additional-properties-json small"><code>@_environment.Details.FormatAdditionalPropertiesJson()</code></pre>
                </CollapsibleSection>
            </div>
        </div>
    }

    <EnvironmentDetailsCollectionSection Title="Servers" Items="_environment.Details.Servers">
        <HeaderContent>
            <tr>
                <th>Component name</th>
                <th>Name</th>
                <th>Server type</th>
                <th>Description</th>
                <th>Identifier</th>
                <th>Resource name</th>
            </tr>
        </HeaderContent>
        <RowTemplate Context="server">
            <tr>
                <td>@(server.ComponentName ?? "—")</td>
                <td>@(server.Name ?? "—")</td>
                <td>@(server.ServerType ?? "—")</td>
                <td>@(server.ComponentDescription ?? "—")</td>
                <td><code>@(server.ComponentIdenifier ?? "—")</code></td>
                <td><code>@(server.ComponentResourceNameResolved ?? "—")</code></td>
            </tr>
        </RowTemplate>
    </EnvironmentDetailsCollectionSection>

    <EnvironmentUrlsSection EnvironmentUrls="_environment.Details.EnvironmentUrls"
                            EnvironmentDetails="_environment.Details"
                            DeploymentDetails="_environment.DeploymentDetails"
                            EnvironmentId="LocalId"
                            Instances="_instances"
                            IsBusy="@(_isBusy || _isSavingDeployment)"
                            OnRegistrationRequested="HandleRegistrationRequestedAsync" />

    <WebSitesSection WebSites="_environment.Details.WebSites"
                     EnvironmentDetails="_environment.Details"
                     DeploymentDetails="_environment.DeploymentDetails"
                     EnvironmentId="LocalId"
                     Instances="_instances"
                     IsBusy="@(_isBusy || _isSavingDeployment)"
                     OnRegistrationRequested="HandleRegistrationRequestedAsync" />

    <WindowsServicesSection WindowsServices="_environment.Details.WindowsServices"
                            EnvironmentDetails="_environment.Details"
                            DeploymentDetails="_environment.DeploymentDetails"
                            EnvironmentId="LocalId"
                            Instances="_instances"
                            IsBusy="@(_isBusy || _isSavingDeployment)"
                            OnRegistrationRequested="HandleRegistrationRequestedAsync" />

    <div class="mt-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <h2 class="h4 mb-0">Deployed applications</h2>
            @if (!_isDeploymentFormVisible && _deployableApplications.Count > 0)
            {
                <button type="button"
                        class="btn btn-primary"
                        disabled="@(_isBusy || !CanAddDeployment)"
                        title="@(CanAddDeployment ? null : "All deployable applications are already registered in this environment.")"
                        @onclick="ShowCreateDeploymentForm">
                    Add deployment
                </button>
            }
        </div>

        @if (_isDeploymentFormVisible)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="h5 mb-3">@(_editingInstanceId is null ? "Add deployment" : "Edit deployment")</h3>
                    <EditForm Model="_deploymentForm" OnValidSubmit="SaveDeploymentAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="deployment-app">Application</label>
                                <InputSelect id="deployment-app"
                                             class="form-select"
                                             @bind-Value="_deploymentForm.DeployableApplicationId"
                                             @bind-Value:after="OnDeployableApplicationSelected"
                                             disabled="@(_isBusy || _editingInstanceId is not null)">
                                    <option value="">Select an application…</option>
                                    @foreach (var application in GetAvailableApplicationsForForm())
                                    {
                                        <option value="@application.Id">@application.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="deployment-build">Build number</label>
                                <InputText id="deployment-build"
                                           class="form-control"
                                           @bind-Value="_deploymentForm.BuildVersionNumber"
                                           disabled="@_isBusy" />
                                @if (_environment.DeploymentDetails is null && _editingInstanceId is null)
                                {
                                    <div class="form-text text-muted">
                                        Refresh this environment to load the build number from deployment details.
                                    </div>
                                }
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="deployment-feed">Pipeline feed</label>
                                <InputSelect id="deployment-feed"
                                             class="form-select"
                                             @bind-Value="_deploymentForm.PipelineFeedId"
                                             disabled="@_isBusy">
                                    <option value="">(None)</option>
                                    @foreach (var feed in _pipelineFeeds)
                                    {
                                        <option value="@feed.Id">@feed.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="deployment-branch">Source branch</label>
                                <InputText id="deployment-branch"
                                           class="form-control"
                                           @bind-Value="_deploymentForm.SourceBranch"
                                           disabled="@_isBusy" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="deployment-deployed-at">Deployed at</label>
                                <InputDate id="deployment-deployed-at"
                                           class="form-control"
                                           @bind-Value="_deploymentForm.DeployedAt"
                                           disabled="@_isBusy" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="deployment-sql">SQL Server instance override</label>
                                <InputText id="deployment-sql"
                                           class="form-control"
                                           @bind-Value="_deploymentForm.SqlServerInstance"
                                           disabled="@_isBusy" />
                                <div class="form-text">Optional — only if this app uses a different instance than the environment.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="deployment-path">Physical path</label>
                                <InputText id="deployment-path"
                                           class="form-control"
                                           @bind-Value="_deploymentForm.PhysicalPath"
                                           @bind-Value:after="OnDeploymentPhysicalPathChanged"
                                           disabled="@_isBusy" />
                                @if (GetSelectedDeployableApplication()?.PathToPhysicalPath is { Length: > 0 } physicalPathTemplate)
                                {
                                    <div class="form-text">
                                        Template: <code>@physicalPathTemplate</code>
                                        @if (string.IsNullOrWhiteSpace(_deploymentForm.PhysicalPath))
                                        {
                                            <span class="text-muted"> — not all tokens could be resolved from this environment's remote data yet.</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="deployment-log-path">Log path</label>
                                <InputText id="deployment-log-path"
                                           class="form-control"
                                           @bind-Value="_deploymentForm.LogPath"
                                           disabled="@_isBusy" />
                                @if (GetSelectedDeployableApplication()?.PathToLogFiles is { Length: > 0 } logPathTemplate)
                                {
                                    <div class="form-text">
                                        Template: <code>@logPathTemplate</code>
                                        @if (string.IsNullOrWhiteSpace(_deploymentForm.LogPath))
                                        {
                                            <span class="text-muted"> — not all tokens could be resolved from this environment's remote data yet.</span>
                                        }
                                    </div>
                                }
                            </div>
                            @if (IsSelectedAppWebApp)
                            {
                                <div class="col-12">
                                    <label class="form-label" for="deployment-homepage">Homepage URL</label>
                                    <InputText id="deployment-homepage"
                                               class="form-control"
                                               @bind-Value="_deploymentForm.HomepageUrl"
                                               disabled="@_isBusy" />
                                </div>
                            }
                            <div class="col-12">
                                <label class="form-label" for="deployment-notes">Notes</label>
                                <InputTextArea id="deployment-notes"
                                               class="form-control"
                                               rows="2"
                                               @bind-Value="_deploymentForm.Notes"
                                               disabled="@_isBusy" />
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                                @(_isSavingDeployment ? "Saving…" : "Save deployment")
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@_isBusy"
                                    @onclick="CancelDeploymentForm">
                                Cancel
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        @if (_deployableApplications.Count == 0)
        {
            <div class="alert alert-light border" role="status">
                <p class="mb-0 text-muted">
                    Register a deployable application on the <a href="/applications">Applications</a> page before adding deployments.
                </p>
            </div>
        }
        else if (_instancesLoading)
        {
            <p class="text-muted">Loading deployed applications…</p>
        }
        else if (_instances.Count == 0)
        {
            <div class="alert alert-light border text-center py-4" role="status">
                <p class="mb-3 text-muted">No applications are deployed in this environment yet.</p>
                @if (!_isDeploymentFormVisible && CanAddDeployment)
                {
                    <button type="button" class="btn btn-primary" @onclick="ShowCreateDeploymentForm">
                        Add your first deployment
                    </button>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle table-deployed-apps">
                    <thead class="table-light">
                        <tr>
                            <th class="table-deployed-apps__app">Application</th>
                            <th class="table-deployed-apps__build">Build</th>
                            <th class="table-deployed-apps__homepage">Homepage</th>
                            <th class="table-deployed-apps__action">Logs</th>
                            <th class="table-deployed-apps__action">Configuration</th>
                            <th class="table-deployed-apps__action">Packages</th>
                            <th class="table-deployed-apps__action">Edit</th>
                            <th class="table-deployed-apps__action">Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var instance in _instances)
                        {
                            var isDeleting = _deletingInstanceId == instance.Id;
                            var hasHomepage = instance.DeployableApplication.IsWebApp
                                              && !string.IsNullOrWhiteSpace(instance.HomepageUrl);
                            <tr>
                                <td class="table-deployed-apps__app">
                                    <span class="table-deployed-apps__truncate" title="@instance.DeployableApplication.Name">
                                        @instance.DeployableApplication.Name
                                    </span>
                                </td>
                                <td class="table-deployed-apps__build">
                                    <code class="table-deployed-apps__build-code">@instance.BuildVersionNumber</code>
                                </td>
                                <td class="table-deployed-apps__homepage">
                                    @if (hasHomepage)
                                    {
                                        <a href="@instance.HomepageUrl"
                                           class="table-deployed-apps__truncate"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           title="@instance.HomepageUrl">
                                            @instance.HomepageUrl
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="table-deployed-apps__action">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/log-viewer/{instance.Id}")">
                                        Logs
                                    </a>
                                </td>
                                <td class="table-deployed-apps__action">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/configuration/{instance.Id}")">
                                        Configuration
                                    </a>
                                </td>
                                <td class="table-deployed-apps__action">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/packages/{instance.Id}")">
                                        Packages
                                    </a>
                                </td>
                                <td class="table-deployed-apps__action">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled="@_isBusy"
                                            @onclick="() => ShowEditDeploymentForm(instance)">
                                        Edit
                                    </button>
                                </td>
                                <td class="table-deployed-apps__action">
                                    @if (isDeleting)
                                    {
                                        <div class="table-deployed-apps__delete-confirm">
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    disabled="@_isBusy"
                                                    @onclick="() => ConfirmDeleteDeploymentAsync(instance.Id)">
                                                Confirm
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    disabled="@_isBusy"
                                                    @onclick="CancelDeleteDeployment">
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                disabled="@_isBusy"
                                                title="Remove this deployment from the environment"
                                                @onclick="() => PromptDeleteDeployment(instance.Id)">
                                            Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid LocalId { get; set; }

    private CachedEnvironment? _environment;
    private IReadOnlyList<ApplicationInstance> _instances = [];
    private IReadOnlyList<DeployableApplication> _deployableApplications = [];
    private IReadOnlyList<PipelineFeed> _pipelineFeeds = [];
    private bool _isLoading = true;
    private bool _instancesLoading;
    private bool _isBusy;
    private bool _isRefreshing;
    private bool _isDeploymentFormVisible;
    private bool _isSavingDeployment;
    private Guid? _editingInstanceId;
    private Guid? _deletingInstanceId;
    private string? _errorMessage;
    private DeploymentFormModel _deploymentForm = new();

    private bool CanAddDeployment =>
        _deployableApplications.Any(app => !_instances.Any(instance => instance.DeployableApplicationId == app.Id));

    private bool IsSelectedAppWebApp =>
        _deployableApplications.FirstOrDefault(app => app.Id == _deploymentForm.DeployableApplicationId)?.IsWebApp == true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEnvironmentAsync();
    }

    private async Task LoadEnvironmentAsync()
    {
        _errorMessage = null;
        _isLoading = _environment is null;

        try
        {
            _environment = await EnvironmentService.GetTrackedEnvironmentAsync(LocalId);

            if (_environment is not null)
            {
                await LoadDeploymentDataAsync();
                ApplyRegistrationPrefillIfPresent();
            }
            else
            {
                _instances = [];
                _deployableApplications = [];
                _pipelineFeeds = [];
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load environment: {ex.Message}";
            _environment = null;
            _instances = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadInstancesAsync()
    {
        _instancesLoading = _instances.Count == 0;

        try
        {
            _instances = await InstanceService.GetByEnvironmentIdAsync(LocalId);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load deployed applications: {ex.Message}";
            _instances = [];
        }
        finally
        {
            _instancesLoading = false;
        }
    }

    private async Task LoadDeploymentDataAsync()
    {
        _instancesLoading = _instances.Count == 0;

        try
        {
            _deployableApplications = await DeployableApplicationService.GetAllAsync();
            _pipelineFeeds = await PipelineFeedService.GetAllAsync();
            await LoadInstancesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load deployment data: {ex.Message}";
            _instances = [];
            _deployableApplications = [];
            _pipelineFeeds = [];
            _instancesLoading = false;
        }
    }

    private IEnumerable<DeployableApplication> GetAvailableApplicationsForForm()
    {
        if (_editingInstanceId is not null)
        {
            var editing = _instances.First(instance => instance.Id == _editingInstanceId);
            return _deployableApplications.Where(app => app.Id == editing.DeployableApplicationId);
        }

        var deployedAppIds = _instances.Select(instance => instance.DeployableApplicationId).ToHashSet();
        return _deployableApplications.Where(app => !deployedAppIds.Contains(app.Id));
    }

    private void ShowCreateDeploymentForm()
    {
        _errorMessage = null;
        _editingInstanceId = null;
        _deploymentForm = new DeploymentFormModel
        {
            BuildVersionNumber = _environment?.DeploymentDetails?.GetPrimaryBuild()?.BuildVersionNumber ?? "0"
        };
        _isDeploymentFormVisible = true;
    }

    private DeployableApplication? GetSelectedDeployableApplication() =>
        _deployableApplications.FirstOrDefault(app => app.Id == _deploymentForm.DeployableApplicationId);

    private void OnDeployableApplicationSelected() => ApplyManualDeploymentPrefill();

    private void OnDeploymentPhysicalPathChanged() => ApplyManualDeploymentPrefill(physicalPathOnly: true);

    private void ApplyManualDeploymentPrefill(bool physicalPathOnly = false)
    {
        if (_environment is null
            || _editingInstanceId is not null
            || _deploymentForm.DeployableApplicationId == Guid.Empty)
        {
            return;
        }

        var application = GetSelectedDeployableApplication();
        if (application is null)
        {
            return;
        }

        var prefill = RegistrationMapper.BuildManualDeploymentPrefill(
            _environment.Details,
            application,
            _environment.DeploymentDetails,
            NormalizeOptional(_deploymentForm.PhysicalPath));

        if (!physicalPathOnly)
        {
            if (!string.IsNullOrWhiteSpace(prefill.HomepageUrl))
            {
                _deploymentForm.HomepageUrl = prefill.HomepageUrl;
            }

            if (!string.IsNullOrWhiteSpace(prefill.PhysicalPath)
                && string.IsNullOrWhiteSpace(_deploymentForm.PhysicalPath))
            {
                _deploymentForm.PhysicalPath = prefill.PhysicalPath;
            }

            if (!string.IsNullOrWhiteSpace(prefill.BuildVersionNumber))
            {
                _deploymentForm.BuildVersionNumber = prefill.BuildVersionNumber;
            }

            if (!string.IsNullOrWhiteSpace(prefill.SourceBranch))
            {
                _deploymentForm.SourceBranch = prefill.SourceBranch;
            }
        }

        if (!string.IsNullOrWhiteSpace(prefill.LogPath))
        {
            _deploymentForm.LogPath = prefill.LogPath;
        }
    }

    private void ShowCreateDeploymentForm(ApplicationInstanceRegistrationPrefill prefill)
    {
        _errorMessage = null;
        _editingInstanceId = null;
        _deploymentForm = new DeploymentFormModel
        {
            DeployableApplicationId = prefill.DeployableApplicationId ?? Guid.Empty,
            BuildVersionNumber = prefill.BuildVersionNumber ?? string.Empty,
            PipelineFeedId = prefill.PipelineFeedId,
            SourceBranch = prefill.SourceBranch ?? string.Empty,
            DeployedAt = prefill.DeployedAt?.LocalDateTime.Date,
            PhysicalPath = prefill.PhysicalPath ?? string.Empty,
            LogPath = prefill.LogPath ?? string.Empty,
            HomepageUrl = prefill.HomepageUrl ?? string.Empty,
            SqlServerInstance = prefill.SqlServerInstance ?? string.Empty,
            Notes = prefill.Notes ?? string.Empty
        };
        _isDeploymentFormVisible = true;
    }

    private void ShowEditDeploymentForm(ApplicationInstance instance, ApplicationInstanceRegistrationPrefill prefill)
    {
        _errorMessage = null;
        _editingInstanceId = instance.Id;
        _deploymentForm = new DeploymentFormModel
        {
            DeployableApplicationId = instance.DeployableApplicationId,
            BuildVersionNumber = instance.BuildVersionNumber,
            PipelineFeedId = instance.PipelineFeedId ?? prefill.PipelineFeedId,
            SourceBranch = prefill.SourceBranch ?? instance.SourceBranch ?? string.Empty,
            DeployedAt = (prefill.DeployedAt ?? instance.DeployedAt)?.LocalDateTime.Date,
            PhysicalPath = prefill.PhysicalPath ?? instance.PhysicalPath ?? string.Empty,
            LogPath = prefill.LogPath ?? instance.LogPath ?? string.Empty,
            HomepageUrl = prefill.HomepageUrl ?? instance.HomepageUrl ?? string.Empty,
            SqlServerInstance = prefill.SqlServerInstance ?? instance.SqlServerInstance ?? string.Empty,
            Notes = prefill.Notes ?? instance.Notes ?? string.Empty
        };
        _isDeploymentFormVisible = true;
    }

    private void ApplyRegistrationPrefillIfPresent()
    {
        var prefill = RegistrationPrefillState.Take();
        if (prefill is null || prefill.EnvironmentLocalId != LocalId)
        {
            if (prefill is not null)
            {
                RegistrationPrefillState.Set(prefill);
            }

            return;
        }

        if (prefill.RequiresApplicationCreate)
        {
            RegistrationPrefillState.Set(prefill);
            return;
        }

        OpenRegistrationPrefill(prefill);
    }

    private Task HandleRegistrationRequestedAsync(RemoteRegistrationPrefill prefill)
    {
        OpenRegistrationPrefill(prefill);
        return Task.CompletedTask;
    }

    private void OpenRegistrationPrefill(RemoteRegistrationPrefill prefill)
    {
        _deletingInstanceId = null;

        if (prefill.IsUpdate && prefill.Instance.ExistingInstanceId is Guid instanceId)
        {
            var instance = _instances.FirstOrDefault(item => item.Id == instanceId);
            if (instance is not null)
            {
                ShowEditDeploymentForm(instance, prefill.Instance);
            }

            return;
        }

        ShowCreateDeploymentForm(prefill.Instance);
        if (prefill.Instance.DeployableApplicationId is not null)
        {
            ApplyManualDeploymentPrefill();
        }
    }

    private void ShowEditDeploymentForm(ApplicationInstance instance)
    {
        _errorMessage = null;
        _editingInstanceId = instance.Id;
        _deploymentForm = new DeploymentFormModel
        {
            DeployableApplicationId = instance.DeployableApplicationId,
            BuildVersionNumber = instance.BuildVersionNumber,
            PipelineFeedId = instance.PipelineFeedId,
            SourceBranch = instance.SourceBranch ?? string.Empty,
            DeployedAt = instance.DeployedAt?.LocalDateTime.Date,
            PhysicalPath = instance.PhysicalPath ?? string.Empty,
            LogPath = instance.LogPath ?? string.Empty,
            HomepageUrl = instance.HomepageUrl ?? string.Empty,
            SqlServerInstance = instance.SqlServerInstance ?? string.Empty,
            Notes = instance.Notes ?? string.Empty
        };
        _isDeploymentFormVisible = true;
    }

    private void CancelDeploymentForm()
    {
        _isDeploymentFormVisible = false;
        _editingInstanceId = null;
        _deploymentForm = new DeploymentFormModel();
    }

    private void PromptDeleteDeployment(Guid instanceId)
    {
        _errorMessage = null;
        _deletingInstanceId = instanceId;
        _isDeploymentFormVisible = false;
        _editingInstanceId = null;
    }

    private void CancelDeleteDeployment()
    {
        _deletingInstanceId = null;
    }

    private async Task ConfirmDeleteDeploymentAsync(Guid instanceId)
    {
        if (_environment is null)
        {
            return;
        }

        var instance = _instances.FirstOrDefault(item => item.Id == instanceId);
        if (instance is null)
        {
            _deletingInstanceId = null;
            return;
        }

        _errorMessage = null;
        _isBusy = true;

        try
        {
            await InstanceService.DeleteAsync(instanceId);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Deployment removed",
                Detail = $"{instance.DeployableApplication.Name} was removed from {_environment.Details.Name}.",
                Duration = 4000
            });

            _deletingInstanceId = null;
            await LoadDeploymentDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SaveDeploymentAsync()
    {
        if (_environment is null || _deploymentForm.DeployableApplicationId == Guid.Empty)
        {
            _errorMessage = "Select a deployable application.";
            return;
        }

        _errorMessage = null;
        _isBusy = true;
        _isSavingDeployment = true;

        try
        {
            var upsert = new ApplicationInstanceUpsert
            {
                DeployableApplicationId = _deploymentForm.DeployableApplicationId,
                EnvironmentId = LocalId,
                BuildVersionNumber = _deploymentForm.BuildVersionNumber.Trim(),
                PipelineFeedId = _deploymentForm.PipelineFeedId,
                SourceBranch = NormalizeOptional(_deploymentForm.SourceBranch),
                DeployedAt = _deploymentForm.DeployedAt.HasValue
                    ? new DateTimeOffset(_deploymentForm.DeployedAt.Value, TimeZoneInfo.Local.GetUtcOffset(_deploymentForm.DeployedAt.Value))
                    : null,
                PhysicalPath = NormalizeOptional(_deploymentForm.PhysicalPath),
                LogPath = NormalizeOptional(_deploymentForm.LogPath),
                HomepageUrl = IsSelectedAppWebApp ? NormalizeOptional(_deploymentForm.HomepageUrl) : null,
                SqlServerInstance = NormalizeOptional(_deploymentForm.SqlServerInstance),
                Notes = NormalizeOptional(_deploymentForm.Notes)
            };

            var saved = await InstanceService.UpsertAsync(upsert);
            var appName = _deployableApplications.First(app => app.Id == saved.DeployableApplicationId).Name;

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = _editingInstanceId is null ? "Deployment added" : "Deployment updated",
                Detail = $"{appName} saved for {_environment.Details.Name}.",
                Duration = 4000
            });

            CancelDeploymentForm();
            await LoadDeploymentDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSavingDeployment = false;
            _isBusy = false;
        }
    }

    private static string? NormalizeOptional(string value)
    {
        var trimmed = value.Trim();
        return trimmed.Length == 0 ? null : trimmed;
    }

    private sealed class DeploymentFormModel
    {
        [Required(ErrorMessage = "Select an application.")]
        public Guid DeployableApplicationId { get; set; }

        [Required(ErrorMessage = "Build number is required.")]
        [StringLength(100, ErrorMessage = "Build number must be 100 characters or fewer.")]
        public string BuildVersionNumber { get; set; } = string.Empty;

        public Guid? PipelineFeedId { get; set; }

        [StringLength(500, ErrorMessage = "Source branch must be 500 characters or fewer.")]
        public string SourceBranch { get; set; } = string.Empty;

        public DateTime? DeployedAt { get; set; }

        [StringLength(2000, ErrorMessage = "Physical path must be 2000 characters or fewer.")]
        public string PhysicalPath { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Log path must be 2000 characters or fewer.")]
        public string LogPath { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Homepage URL must be 2000 characters or fewer.")]
        public string HomepageUrl { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "SQL Server instance must be 500 characters or fewer.")]
        public string SqlServerInstance { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "Notes must be 2000 characters or fewer.")]
        public string Notes { get; set; } = string.Empty;
    }
    //TODO This needs to be checked, it's probably wrong.
    private string? GetPrimaryBuildNumberText() =>
        _environment?.DeploymentDetails?.GetPrimaryBuild()?.BuildVersionNumber;

    private string? GetPrimaryWipBranch() =>
        _environment?.DeploymentDetails?.GetPrimaryWipBranch();

    private string? GetPrimaryBuildWorkItemUrl(string buildNumber) =>
        TfsWorkItemLinkBuilder.BuildWorkItemUrl(TfsOptions.Value.WorkItemUrlTemplate, buildNumber);

    private async Task CopySqlServerInstanceAsync(string sqlServerInstance)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("devDashClipboard.copyText", sqlServerInstance);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Copied",
                Detail = "SQL Server instance copied to clipboard.",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Copy failed",
                Detail = ex.Message,
                Duration = 5000
            });
        }
    }

    private async Task RefreshAsync()
    {
        if (_environment is null)
        {
            return;
        }

        _errorMessage = null;
        _isBusy = true;
        _isRefreshing = true;

        try
        {
            _environment = await EnvironmentService.RefreshEnvironmentAsync(_environment.RemoteId);
            await LoadDeploymentDataAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Environment refreshed",
                Detail = $"{_environment.Details.Name} refreshed at {_environment.DateLastRefreshed.ToLocalTime():g}",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not refresh environment: {ex.Message}";
        }
        finally
        {
            _isRefreshing = false;
            _isBusy = false;
        }
    }
}
