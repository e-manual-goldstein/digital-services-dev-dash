@namespace DigitalDevServices.DevDash.Pages.Environments
@inject IRemoteEnvironmentRegistrationMapper RegistrationMapper
@inject IRegistrationPrefillState RegistrationPrefillState
@inject NavigationManager Navigation

@if (WebSites.Count > 0)
{
    <div class="card mt-3">
        <div class="card-body">
            <CollapsibleSection Title="@($"Web sites ({WebSites.Count})")">
                @foreach (var site in WebSites)
                {
                    <div class="mt-3">
                        <CollapsibleSection Title="@site.FormatSectionTitle()">
                        @if (site.WebApplications.Length == 0)
                        {
                            <p class="text-muted small mb-0">No web applications.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Application pool</th>
                                            <th>Path</th>
                                            <th>Physical path</th>
                                            <th style="width: 9rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var webApplication in site.WebApplications)
                                        {
                                            <tr>
                                                <td>@(webApplication.ApplicationPoolName ?? "—")</td>
                                                <td><code>@(webApplication.Path ?? "—")</code></td>
                                                <td><code>@(webApplication.PhysicalPath ?? "—")</code></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (IsRegistered(webApplication))
                                                        {
                                                            <span class="badge text-bg-success">Registered</span>
                                                        }
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary"
                                                                disabled="@(IsBusy || !CanRegister(webApplication))"
                                                                @onclick="() => BeginRegistrationAsync(site, webApplication)">
                                                            @(IsRegistered(webApplication) ? "Update" : "Register")
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        </CollapsibleSection>
                    </div>
                }
            </CollapsibleSection>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<EnvironmentWebSite> WebSites { get; set; } = [];

    [Parameter, EditorRequired]
    public RemoteEnvironmentDetails EnvironmentDetails { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid EnvironmentId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ApplicationInstance> Instances { get; set; } = [];

    [Parameter]
    public RemoteEnvironmentDeploymentDetails? DeploymentDetails { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, RemoteBuildVersionDetails>? BuildVersionDetailsByBuildNumber { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<RemoteRegistrationPrefill> OnRegistrationRequested { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private static bool CanRegister(EnvironmentWebApplication webApplication) =>
        webApplication.ResolveDeployableApplicationName() is not null;

    private bool IsRegistered(EnvironmentWebApplication webApplication)
    {
        var applicationName = webApplication.ResolveDeployableApplicationName();
        if (applicationName is null)
        {
            return false;
        }

        return Instances.Any(instance =>
            instance.DeployableApplication.Name.Equals(
                applicationName,
                StringComparison.OrdinalIgnoreCase));
    }

    private async Task BeginRegistrationAsync(EnvironmentWebSite webSite, EnvironmentWebApplication webApplication)
    {
        var prefill = await RegistrationMapper.BuildFromWebApplicationAsync(
            EnvironmentId,
            EnvironmentDetails,
            webSite,
            webApplication,
            DeploymentDetails,
            BuildVersionDetailsByBuildNumber);

        if (prefill.RequiresApplicationCreate)
        {
            RegistrationPrefillState.Set(prefill);
            Navigation.NavigateTo("/applications");
            return;
        }

        await OnRegistrationRequested.InvokeAsync(prefill);
    }
}
