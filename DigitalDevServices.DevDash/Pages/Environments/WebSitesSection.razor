@namespace DigitalDevServices.DevDash.Pages.Environments
@inject IRemoteEnvironmentRegistrationService RegistrationService
@inject NotificationService NotificationService

@if (WebSites.Count > 0)
{
    <div class="card mt-3">
        <div class="card-body">
            <CollapsibleSection Title="@($"Web sites ({WebSites.Count})")">
                @foreach (var site in WebSites)
                {
                    <div class="mt-3">
                        <CollapsibleSection Title="@(site.MachineName ?? "Unknown machine")">
                        @if (site.WebApplications.Length == 0)
                        {
                            <p class="text-muted small mb-0">No web applications.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Application pool</th>
                                            <th>Path</th>
                                            <th>Physical path</th>
                                            <th style="width: 9rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var webApplication in site.WebApplications)
                                        {
                                            <tr>
                                                <td>@(webApplication.ApplicationPoolName ?? "—")</td>
                                                <td><code>@(webApplication.Path ?? "—")</code></td>
                                                <td><code>@(webApplication.PhysicalPath ?? "—")</code></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (IsRegistered(webApplication))
                                                        {
                                                            <span class="badge text-bg-success">Registered</span>
                                                        }
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary"
                                                                disabled="@(IsBusy || !CanRegister(webApplication) || _registeringKey == GetRegistrationKey(webApplication))"
                                                                @onclick="() => RegisterAsync(webApplication)">
                                                            @(_registeringKey == GetRegistrationKey(webApplication)
                                                                ? "Registering…"
                                                                : IsRegistered(webApplication) ? "Update" : "Register")
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        </CollapsibleSection>
                    </div>
                }
            </CollapsibleSection>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<EnvironmentWebSite> WebSites { get; set; } = [];

    [Parameter, EditorRequired]
    public Guid EnvironmentId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ApplicationInstance> Instances { get; set; } = [];

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnRegistrationComplete { get; set; }

    private string? _registeringKey;

    private static bool CanRegister(EnvironmentWebApplication webApplication) =>
        webApplication.ResolveDeployableApplicationName() is not null
        && !string.IsNullOrWhiteSpace(webApplication.PhysicalPath);

    private static string GetRegistrationKey(EnvironmentWebApplication webApplication) =>
        $"{webApplication.Path}|{webApplication.ApplicationPoolName}|{webApplication.PhysicalPath}";

    private bool IsRegistered(EnvironmentWebApplication webApplication)
    {
        var applicationName = webApplication.ResolveDeployableApplicationName();
        if (applicationName is null)
        {
            return false;
        }

        return Instances.Any(instance =>
            instance.DeployableApplication.Name.Equals(
                applicationName,
                StringComparison.OrdinalIgnoreCase));
    }

    private async Task RegisterAsync(EnvironmentWebApplication webApplication)
    {
        _registeringKey = GetRegistrationKey(webApplication);

        try
        {
            var instance = await RegistrationService.RegisterFromWebApplicationAsync(
                EnvironmentId,
                webApplication);
            await OnRegistrationComplete.InvokeAsync();

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Application registered",
                Detail = $"{instance.DeployableApplication.Name} linked with physical path.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Registration failed",
                Detail = ex.Message,
                Duration = 6000
            });
        }
        finally
        {
            _registeringKey = null;
        }
    }
}
