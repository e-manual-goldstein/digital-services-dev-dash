@page "/environments/{LocalId:guid}/instances/{InstanceId:guid}/packages"
@inject IEnvironmentService EnvironmentService
@inject IApplicationInstanceService InstanceService
@inject IDeployedPackageService PackageService

<PageTitle>@(_pageTitle)</PageTitle>

<div class="mb-3">
    @if (_environment is not null)
    {
        <a href="@($"/environments/{LocalId}")" class="text-decoration-none">&larr; Back to @_environment.Details.Name</a>
    }
    else
    {
        <a href="/environments" class="text-decoration-none">&larr; Back to environments</a>
    }
</div>

@if (_isLoading)
{
    <p class="text-muted">Loading packages…</p>
}
else if (_instance is null || (_environment is not null && _instance.EnvironmentId != LocalId))
{
    <div class="alert alert-warning" role="alert">
        Application instance not found in this environment.
    </div>
}
else
{
    <div class="mb-3">
        <h1 class="mb-1">Packages</h1>
        <p class="text-muted mb-0">
            @(_environment?.Details.Name ?? "Environment") &middot; @_instance.DeployableApplication.Name
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_scanResult?.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">@_scanResult.ErrorMessage</div>
    }
    else if (_scanResult?.Packages.Count == 0)
    {
        <div class="alert alert-light border text-center py-4" role="status">
            <p class="mb-0 text-muted">No DLL files were found in the deployment folder.</p>
        </div>
    }
    else if (_scanResult is not null)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>File name</th>
                        <th>File version</th>
                        <th>Assembly version</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var package in _scanResult.Packages)
                    {
                        <tr>
                            <td><code>@package.FileName</code></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(package.FileVersion))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @package.FileVersion
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(package.AssemblyVersion))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @package.AssemblyVersion
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter]
    public Guid LocalId { get; set; }

    [Parameter]
    public Guid InstanceId { get; set; }

    private CachedEnvironment? _environment;
    private ApplicationInstance? _instance;
    private DeployedPackageScanResult? _scanResult;
    private bool _isLoading = true;
    private string _pageTitle = "Packages";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _environment = null;
        _instance = null;
        _scanResult = null;

        try
        {
            _environment = await EnvironmentService.GetTrackedEnvironmentAsync(LocalId);
            _instance = await InstanceService.GetByIdAsync(InstanceId);

            if (_instance is null || (_environment is not null && _instance.EnvironmentId != LocalId))
            {
                _pageTitle = "Packages";
                return;
            }

            _pageTitle = $"Packages — {_instance.DeployableApplication.Name}";
            _scanResult = await PackageService.ScanAsync(InstanceId);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
