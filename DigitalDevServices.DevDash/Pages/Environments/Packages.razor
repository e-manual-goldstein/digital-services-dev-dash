@page "/environments/{LocalId:guid}/instances/{InstanceId:guid}/packages"
@inject NavigationManager Navigation

@code {
    [Parameter]
    public Guid LocalId { get; set; }

    [Parameter]
    public Guid InstanceId { get; set; }

    protected override void OnInitialized()
    {
        Navigation.NavigateTo($"/packages/{InstanceId}", replace: true);
    }
}
