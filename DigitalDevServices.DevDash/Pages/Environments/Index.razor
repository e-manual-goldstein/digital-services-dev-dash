@page "/environments"
@inject IEnvironmentService EnvironmentService
@inject NotificationService NotificationService

<PageTitle>Environments</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
        <h1 class="mb-1">Environments</h1>
        <p class="text-muted mb-0">Environments defined by the remote system.</p>
    </div>
    <button type="button"
            class="btn btn-outline-secondary"
            disabled="@_isBusy"
            @onclick="RefreshAllAsync">
        @(_isRefreshingAll ? "Refreshing…" : "Refresh all")
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_isLoading)
{
    <p class="text-muted">Loading environments from remote API…</p>
}
else if (_environments.Count == 0)
{
    <div class="alert alert-light border text-center py-5" role="status">
        <p class="mb-0 text-muted">No environments were returned from the remote API.</p>
    </div>
}
else
{
    @if (_loadedFromCache)
    {
        <p class="text-muted small mb-2">Showing cached data. Use Refresh all or refresh a row to fetch the latest from the API.</p>
    }

    <h2 class="h5 mb-3">Favourites</h2>
    @if (_favouriteEnvironments.Count == 0)
    {
        <p class="text-muted mb-4">No favourites yet — star an environment below.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Remote id</th>
                        <th>Last updated</th>
                        <th style="width: 3rem;"></th>
                        <th style="width: 7rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var environment in _favouriteEnvironments)
                    {
                        @EnvironmentRow(environment)
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="h5 mb-3">All environments</h2>
    @if (_otherEnvironments.Count == 0)
    {
        <p class="text-muted">Every environment is in your favourites list.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Remote id</th>
                        <th>Last updated</th>
                        <th style="width: 3rem;"></th>
                        <th style="width: 7rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var environment in _otherEnvironments)
                    {
                        @EnvironmentRow(environment)
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private IReadOnlyList<CachedEnvironment> _environments = [];
    private IReadOnlyList<CachedEnvironment> _favouriteEnvironments = [];
    private IReadOnlyList<CachedEnvironment> _otherEnvironments = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isRefreshingAll;
    private bool _loadedFromCache;
    private int? _refreshingRemoteId;
    private Guid? _togglingFavouriteLocalId;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadEnvironmentsAsync(forceRefresh: false);
    }

    private RenderFragment EnvironmentRow(CachedEnvironment environment) => __builder =>
    {
        var isRefreshing = _refreshingRemoteId == environment.RemoteId;
        var isTogglingFavourite = _togglingFavouriteLocalId == environment.LocalId;

        <tr>
            <td>
                <a href="@($"/environments/{environment.LocalId}")" class="text-decoration-none">@environment.Details.Name</a>
            </td>
            <td><code>@environment.Details.Code</code></td>
            <td>@environment.Details.EnvironmentType</td>
            <td>@environment.RemoteId</td>
            <td>@environment.DateLastUpdated.ToLocalTime().ToString("g")</td>
            <td>
                <button type="button"
                        class="btn btn-sm btn-link @(environment.IsFavourite ? "text-warning" : "text-secondary") p-0"
                        title="@(environment.IsFavourite ? "Remove from favourites" : "Add to favourites")"
                        aria-label="@(environment.IsFavourite ? "Remove from favourites" : "Add to favourites")"
                        disabled="@(_isBusy || isTogglingFavourite)"
                        @onclick="() => ToggleFavouriteAsync(environment)">
                    @(environment.IsFavourite ? "★" : "☆")
                </button>
            </td>
            <td>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        disabled="@(_isBusy || isRefreshing)"
                        @onclick="() => RefreshEnvironmentAsync(environment.RemoteId)">
                    @(isRefreshing ? "Refreshing…" : "Refresh")
                </button>
            </td>
        </tr>
    };

    private async Task LoadEnvironmentsAsync(bool forceRefresh)
    {
        _errorMessage = null;
        _isLoading = _environments.Count == 0;

        try
        {
            _environments = await EnvironmentService.GetEnvironmentsAsync(forceRefresh);
            _loadedFromCache = !forceRefresh && _environments.Any(environment => environment.IsFromCache);
            _favouriteEnvironments = _environments
                .Where(environment => environment.IsFavourite)
                .OrderBy(environment => environment.RemoteId)
                .ToList();
            _otherEnvironments = _environments
                .Where(environment => !environment.IsFavourite)
                .OrderBy(environment => environment.RemoteId)
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load environments: {ex.Message}";
            _environments = [];
            _favouriteEnvironments = [];
            _otherEnvironments = [];
            _loadedFromCache = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAllAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        _isRefreshingAll = true;

        try
        {
            await LoadEnvironmentsAsync(forceRefresh: true);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Environments refreshed",
                Detail = $"{_environments.Count} environment(s) loaded from the remote API.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not refresh environments: {ex.Message}";
        }
        finally
        {
            _isRefreshingAll = false;
            _isBusy = false;
            _loadedFromCache = false;
        }
    }

    private async Task RefreshEnvironmentAsync(int remoteId)
    {
        _errorMessage = null;
        _isBusy = true;
        _refreshingRemoteId = remoteId;

        try
        {
            var refreshed = await EnvironmentService.RefreshEnvironmentAsync(remoteId);
            await LoadEnvironmentsAsync(forceRefresh: false);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Environment refreshed",
                Detail = $"{refreshed.Details.Name} updated at {refreshed.DateLastUpdated.ToLocalTime():g}",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not refresh environment: {ex.Message}";
        }
        finally
        {
            _refreshingRemoteId = null;
            _isBusy = false;
        }
    }

    private async Task ToggleFavouriteAsync(CachedEnvironment environment)
    {
        _errorMessage = null;
        _isBusy = true;
        _togglingFavouriteLocalId = environment.LocalId;

        try
        {
            var isFavourite = !environment.IsFavourite;
            await EnvironmentService.SetFavouriteAsync(environment.LocalId, isFavourite);
            await LoadEnvironmentsAsync(forceRefresh: false);
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = isFavourite ? "Added to favourites" : "Removed from favourites",
                Detail = environment.Details.Name,
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not update favourite: {ex.Message}";
        }
        finally
        {
            _togglingFavouriteLocalId = null;
            _isBusy = false;
        }
    }
}
