@page "/"

<PageTitle>Home</PageTitle>

<h1>Digital Services Dev Dash</h1>
<p class="lead text-muted">Your workspace for environments, deployments, configuration, and logs.</p>

<div class="alert alert-light border mt-4" role="status">
    <p class="mb-0">More tools and views will appear here as features are added.</p>
</div>

<div class="row g-3 mt-2">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Environments</h5>
                <p class="card-text text-muted mb-3">Browse environments and SQL Server instances from the remote API.</p>
                <a class="btn btn-outline-primary" href="/environments">Open environments</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Applications</h5>
                <p class="card-text text-muted mb-3">Register deployable projects from your codebase.</p>
                <a class="btn btn-outline-primary" href="/applications">Open applications</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Pipeline feeds</h5>
                <p class="card-text text-muted mb-3">Register branch feeds and related pipeline output.</p>
                <a class="btn btn-outline-primary" href="/pipeline-feeds">Open pipeline feeds</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Configuration</h5>
                <p class="card-text text-muted mb-3">Browse and refresh captured settings for deployed applications.</p>
                <a class="btn btn-outline-primary" href="/configuration">Open configuration</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Log viewer preview</h5>
                <p class="card-text text-muted mb-3">Step through sample log formats before the full LOG epic ships.</p>
                <a class="btn btn-outline-primary" href="/logs/preview">Open log preview</a>
            </div>
        </div>
    </div>
</div>
