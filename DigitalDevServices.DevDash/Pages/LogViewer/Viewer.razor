@page "/log-viewer/{InstanceId:guid}"
@using DigitalDevServices.DevDash.LogViewer
@inject IEnvironmentService EnvironmentService
@inject IApplicationInstanceService InstanceService
@inject ILogPathResolutionService LogPathResolutionService
@inject ILogReaderService LogReaderService
@inject ILogFormatProfileService LogFormatProfileService
@inject ILogParsingService LogParsingService

<PageTitle>@_pageTitle</PageTitle>

<div class="mb-3">
    @if (_environment is not null)
    {
        <a href="@($"/environments/{_environment.LocalId}")" class="text-decoration-none">&larr; Back to @_environment.Details.Name</a>
    }
    else
    {
        <a href="/log-viewer" class="text-decoration-none">&larr; Back to log viewer</a>
    }
</div>

@if (_isLoading)
{
    <p class="text-muted">@_loadingMessage</p>
}
else if (_instance is null)
{
    <div class="alert alert-warning" role="alert">
        Application instance not found.
    </div>
}
else
{
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
        <div>
            <h1 class="mb-1">Logs</h1>
            <p class="text-muted mb-0">
                @(_environment?.Details.Name ?? "Environment") &middot; @_instance.DeployableApplication.Name
            </p>
            @if (!string.IsNullOrWhiteSpace(_logFilePath))
            {
                <p class="text-muted small mb-0 mt-1">
                    Source: <code>@_logFilePath</code>
                </p>
            }
            @if (!string.IsNullOrWhiteSpace(_instance.LogPath) && _instance.LogPath != _logFilePath)
            {
                <p class="text-muted small mb-0 mt-1">
                    Log path: <code>@_instance.LogPath</code>
                </p>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@_isBusy"
                    @onclick="RefreshTailAsync">
                @(_isRefreshing ? "Refreshing…" : "Refresh tail")
            </button>
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@(_isBusy || !CanLoadMore)"
                    @onclick="LoadMoreAsync">
                Load more
            </button>
        </div>
    </div>

    @if (_showLogFilePicker)
    {
        <div class="card mb-3">
            <div class="card-body py-3">
                <label class="form-label mb-1" for="log-file">Log file</label>
                <InputSelect id="log-file"
                             class="form-select"
                             TValue="string"
                             Value="_selectedLogFilePath"
                             ValueChanged="OnLogFileChangedAsync"
                             ValueExpression="() => _selectedLogFilePath"
                             disabled="@_isBusy">
                    @foreach (var file in _availableLogFiles)
                    {
                        <option value="@file.FilePath">@LogFileDisplay.FormatOptionLabel(file)</option>
                    }
                </InputSelect>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label class="form-label mb-1" for="log-parse-format">Parse as</label>
                    <InputSelect id="log-parse-format"
                                 class="form-select"
                                 TValue="string"
                                 Value="_selectedParseFormat"
                                 ValueChanged="OnParseFormatChangedAsync"
                                 ValueExpression="() => _selectedParseFormat"
                                 disabled="@(_isBusy || string.IsNullOrWhiteSpace(_rawContent))">
                        @if (string.IsNullOrWhiteSpace(_configuredFormatName))
                        {
                            <option value="">Select format…</option>
                        }
                        @foreach (var formatName in _supportedParseFormats)
                        {
                            <option value="@formatName">@LogFormatNames.GetDisplayName(formatName)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12 col-lg-6">
                    <p class="text-muted small mb-0">
                        Configured:
                        @if (!string.IsNullOrWhiteSpace(_configuredFormatName))
                        {
                            <span>@LogFormatNames.GetDisplayName(_configuredFormatName)</span>
                        }
                        else
                        {
                            <span>(none)</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label class="form-label mb-1" for="log-min-level">Minimum level</label>
                    <InputSelect id="log-min-level"
                                 class="form-select"
                                 @bind-Value="_minimumLevel"
                                 disabled="@(_allEntries.Count == 0)">
                        @foreach (var option in LogEntryFilter.MinimumLevelOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12 col-lg-5">
                    <label class="form-label mb-1" for="log-search">Search message</label>
                    <input id="log-search"
                           type="search"
                           class="form-control"
                           placeholder="Contains text…"
                           @bind="_searchText"
                           @bind:event="oninput"
                           disabled="@(_allEntries.Count == 0)" />
                </div>
                <div class="col-12 col-lg-3">
                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            disabled="@(!HasActiveFilters)"
                            @onclick="ClearFilters">
                        Clear filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_rawContent))
    {
        <div class="card mb-3">
            <div class="card-body py-3">
                <CollapsibleSection Title="Raw log content">
                    <div class="log-entry-raw">@_rawContent</div>
                </CollapsibleSection>
            </div>
        </div>
    }

    @if (_allEntries.Count == 0 && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-light border text-center py-4" role="status">
            <p class="mb-0 text-muted">No log entries were parsed from the current tail.</p>
        </div>
    }
    else if (_allEntries.Count > 0 && FilteredEntries.Count == 0)
    {
        <div class="alert alert-light border text-center py-4" role="status">
            <p class="mb-0 text-muted">No entries match the current filters.</p>
        </div>
    }
    else if (FilteredEntries.Count > 0)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <p class="text-muted small mb-0">
                @if (HasActiveFilters)
                {
                    <span>Showing @FilteredEntries.Count of @_allEntries.Count parsed entries from the last @_maxLines raw lines</span>
                }
                else
                {
                    <span>Showing @_allEntries.Count parsed entries from the last @_maxLines raw lines</span>
                }
            </p>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 12rem;">Time</th>
                        <th style="width: 7rem;">Level</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in FilteredEntries)
                    {
                        <tr>
                            <td class="text-muted small font-monospace">
                                @(entry.Timestamp?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff") ?? "—")
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(entry.Level))
                                {
                                    <span class="badge @LogLevelBadge.GetClass(entry.Level)">@entry.Level</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="font-monospace small text-break">@entry.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int DefaultMaxLines = 100;
    private const int MaxLinesStep = 100;
    private const int MaxAllowedLines = 10_000;

    [Parameter]
    public Guid InstanceId { get; set; }

    private ApplicationInstance? _instance;
    private CachedEnvironment? _environment;
    private IReadOnlyList<ParsedLogEntry> _allEntries = [];
    private IReadOnlyList<AvailableLogFile> _availableLogFiles = [];
    private string? _selectedLogFilePath;
    private string? _logFilePath;
    private string? _rawContent;
    private string? _configuredFormatName;
    private string? _configuredParserConfig;
    private string? _selectedParseFormat;
    private IReadOnlyList<string> _supportedParseFormats = [];
    private string _minimumLevel = LogEntryFilter.MinimumLevelAll;
    private string _searchText = string.Empty;
    private string _pageTitle = "Logs";
    private string _loadingMessage = "Loading logs…";
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _isBusy;
    private int _maxLines = DefaultMaxLines;

    private bool CanLoadMore => _maxLines < MaxAllowedLines;

    private bool _showLogFilePicker => _availableLogFiles.Count > 1;

    private IReadOnlyList<ParsedLogEntry> FilteredEntries =>
        LogEntryFilter.Apply(_allEntries, _minimumLevel, _searchText);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_minimumLevel) || !string.IsNullOrWhiteSpace(_searchText);

    protected override void OnInitialized()
    {
        _supportedParseFormats = LogParsingService.GetSupportedFormatNames();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        _errorMessage = null;
        _isLoading = true;
        _loadingMessage = "Loading logs…";
        _allEntries = [];
        _logFilePath = null;
        _rawContent = null;
        _configuredFormatName = null;
        _configuredParserConfig = null;
        _selectedParseFormat = null;
        _availableLogFiles = [];
        _selectedLogFilePath = null;

        try
        {
            _instance = await InstanceService.GetByIdAsync(InstanceId);
            if (_instance is null)
            {
                _pageTitle = "Logs";
                return;
            }

            _pageTitle = $"{_instance.DeployableApplication.Name} logs";
            _environment = await EnvironmentService.GetTrackedEnvironmentAsync(_instance.EnvironmentId);

            var profile = await LogFormatProfileService.GetByDeployableApplicationIdAsync(_instance.DeployableApplicationId);
            _configuredFormatName = profile?.FormatName;
            _configuredParserConfig = profile?.ParserConfig;
            _selectedParseFormat = _configuredFormatName;

            if (string.IsNullOrWhiteSpace(_instance.LogPath))
            {
                _loadingMessage = "Resolving log path…";
                var resolution = await LogPathResolutionService.EnsureLogPathAsync(InstanceId);
                if (resolution.RefreshedEnvironment)
                {
                    _loadingMessage = "Refreshing environment…";
                }

                if (!resolution.IsSuccess)
                {
                    _errorMessage = resolution.ErrorMessage;
                    return;
                }

                _instance = await InstanceService.GetByIdAsync(InstanceId);
            }

            await LoadAvailableLogFilesAsync();
            await ReadLogsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
            _isBusy = false;
        }
    }

    private async Task LoadAvailableLogFilesAsync()
    {
        var listResult = await LogReaderService.ListLogFilesAsync(InstanceId);
        if (!listResult.IsSuccess)
        {
            _errorMessage = listResult.ErrorMessage;
            _availableLogFiles = [];
            _selectedLogFilePath = null;
            return;
        }

        _availableLogFiles = listResult.Files;
        _selectedLogFilePath ??= _availableLogFiles.FirstOrDefault()?.FilePath;
    }

    private async Task OnLogFileChangedAsync(string? logFilePath)
    {
        if (string.IsNullOrWhiteSpace(logFilePath) || logFilePath == _selectedLogFilePath)
        {
            return;
        }

        _selectedLogFilePath = logFilePath;
        _maxLines = DefaultMaxLines;
        await RefreshTailAsync();
    }

    private Task OnParseFormatChangedAsync(string? formatName)
    {
        _selectedParseFormat = formatName;

        if (string.IsNullOrWhiteSpace(_rawContent))
        {
            return Task.CompletedTask;
        }

        if (string.IsNullOrWhiteSpace(formatName))
        {
            _allEntries = [];
            _errorMessage = null;
            return Task.CompletedTask;
        }

        try
        {
            _allEntries = LogParsingService.ParseWithFormat(
                formatName,
                _rawContent,
                string.Equals(formatName, LogFormatNames.CustomRegex, StringComparison.OrdinalIgnoreCase)
                    ? _configuredParserConfig
                    : null);
            _errorMessage = null;
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
            _allEntries = [];
        }

        return Task.CompletedTask;
    }

    private async Task ReadLogsAsync()
    {
        var result = await LogReaderService.ReadAsync(
            InstanceId,
            _maxLines,
            _selectedLogFilePath,
            formatName: _selectedParseFormat,
            parserConfig: string.Equals(_selectedParseFormat, LogFormatNames.CustomRegex, StringComparison.OrdinalIgnoreCase)
                ? _configuredParserConfig
                : null);
        if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
            _allEntries = [];
            _logFilePath = result.LogFilePath;
            _rawContent = result.RawContent;
            return;
        }

        _allEntries = result.Entries;
        _logFilePath = result.LogFilePath;
        _rawContent = result.RawContent;
        _selectedLogFilePath ??= result.LogFilePath;
    }

    private async Task RefreshTailAsync()
    {
        _isBusy = true;
        _isRefreshing = true;
        _errorMessage = null;

        try
        {
            await ReadLogsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRefreshing = false;
            _isBusy = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        _maxLines = Math.Min(_maxLines + MaxLinesStep, MaxAllowedLines);
        await RefreshTailAsync();
    }

    private void ClearFilters()
    {
        _minimumLevel = LogEntryFilter.MinimumLevelAll;
        _searchText = string.Empty;
    }
}
