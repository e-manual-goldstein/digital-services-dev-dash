@page "/git-history"
@inject IGitRepositoryService GitRepositoryService
@inject NotificationService NotificationService

<PageTitle>Git history</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div>
        <h1 class="mb-1">Git history</h1>
        <p class="text-muted mb-0">Track repository migrations and prior Azure DevOps locations per component.</p>
    </div>
    @if (!_isFormVisible)
    {
        <button type="button"
                class="btn btn-primary"
                disabled="@_isBusy"
                @onclick="ShowCreateForm">
            Add repository
        </button>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_isFormVisible)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">@(_editingId is null ? "Add repository" : "Edit repository")</h2>
            <EditForm Model="_formModel" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="git-repo-name">Name</label>
                        <InputText id="git-repo-name"
                                   class="form-control"
                                   @bind-Value="_formModel.Name"
                                   disabled="@_isBusy" />
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                        @(_isSaving ? "Saving…" : "Save")
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@_isBusy"
                            @onclick="CancelForm">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_isLoading)
{
    <p class="text-muted">Loading repositories…</p>
}
else if (_repositories.Count == 0)
{
    <div class="alert alert-light border text-center py-5" role="status">
        <p class="mb-3 text-muted">No git repositories registered yet.</p>
        @if (!_isFormVisible)
        {
            <button type="button" class="btn btn-primary" @onclick="ShowCreateForm">
                Add your first repository
            </button>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Components</th>
                    <th style="width: 11rem;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var repository in _repositories)
                {
                    var isDeleting = _deletingId == repository.Id;
                    <tr>
                        <td>
                            <a href="@($"/git-history/{repository.Id}")" class="text-decoration-none fw-semibold">
                                @repository.Name
                            </a>
                        </td>
                        <td>@repository.ArtifactComponents.Count</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="@($"/git-history/{repository.Id}")">
                                    View
                                </a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        disabled="@_isBusy"
                                        @onclick="() => ShowEditForm(repository)">
                                    Edit
                                </button>
                                @if (isDeleting)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@_isBusy"
                                            @onclick="() => ConfirmDeleteAsync(repository.Id)">
                                        Confirm
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled="@_isBusy"
                                            @onclick="CancelDelete">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled="@_isBusy"
                                            @onclick="() => PromptDelete(repository.Id)">
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<GitRepository> _repositories = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isSaving;
    private bool _isFormVisible;
    private Guid? _editingId;
    private Guid? _deletingId;
    private string? _errorMessage;
    private RepositoryFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _errorMessage = null;
        _isLoading = _repositories.Count == 0;

        try
        {
            _repositories = await GitRepositoryService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load git repositories: {ex.Message}";
            _repositories = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowCreateForm()
    {
        _editingId = null;
        _formModel = new RepositoryFormModel();
        _isFormVisible = true;
    }

    private void ShowEditForm(GitRepository repository)
    {
        _editingId = repository.Id;
        _formModel = new RepositoryFormModel
        {
            Name = repository.Name
        };
        _isFormVisible = true;
    }

    private void CancelForm()
    {
        _isFormVisible = false;
        _editingId = null;
        _formModel = new RepositoryFormModel();
    }

    private async Task SaveAsync()
    {
        _isBusy = true;
        _isSaving = true;
        _errorMessage = null;

        try
        {
            var upsert = new GitRepositoryUpsert
            {
                Name = _formModel.Name
            };

            if (_editingId is null)
            {
                await GitRepositoryService.CreateAsync(upsert);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Repository added",
                    Detail = $"{upsert.Name} was saved.",
                    Duration = 4000
                });
            }
            else
            {
                await GitRepositoryService.UpdateAsync(_editingId.Value, upsert);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Repository updated",
                    Detail = $"{upsert.Name} was saved.",
                    Duration = 4000
                });
            }

            CancelForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
            _isSaving = false;
        }
    }

    private void PromptDelete(Guid id) => _deletingId = id;

    private void CancelDelete() => _deletingId = null;

    private async Task ConfirmDeleteAsync(Guid id)
    {
        _isBusy = true;
        _errorMessage = null;

        try
        {
            await GitRepositoryService.DeleteAsync(id);
            _deletingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class RepositoryFormModel
    {
        [Required]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
