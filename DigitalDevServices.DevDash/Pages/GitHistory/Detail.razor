@page "/git-history/{RepositoryId:guid}"
@inject IGitRepositoryService GitRepositoryService
@inject NotificationService NotificationService

<PageTitle>@_pageTitle</PageTitle>

<div class="mb-3">
    <a href="/git-history" class="text-decoration-none">&larr; Back to git history</a>
</div>

@if (_isLoading)
{
    <p class="text-muted">Loading repository…</p>
}
else if (_repository is null)
{
    <div class="alert alert-warning" role="alert">
        Git repository not found.
    </div>
}
else
{
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="mb-1">@_repository.Name</h1>
            <p class="text-muted mb-0">@_orderedComponents.Count component@(_orderedComponents.Count == 1 ? "" : "s")</p>
        </div>
        @if (!_isRepositoryFormVisible && !_isComponentFormVisible)
        {
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@_isBusy"
                    @onclick="ShowEditRepositoryForm">
                Edit repository
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (_isRepositoryFormVisible)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Edit repository</h2>
                <EditForm Model="_repositoryFormModel" OnValidSubmit="SaveRepositoryAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="detail-repo-name">Name</label>
                            <InputText id="detail-repo-name"
                                       class="form-control"
                                       @bind-Value="_repositoryFormModel.Name"
                                       disabled="@_isBusy" />
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                            @(_isSaving ? "Saving…" : "Save")
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@_isBusy"
                                @onclick="CancelRepositoryForm">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <h2 class="h4 mb-0">Components</h2>
        @if (!_isComponentFormVisible && !_isRepositoryFormVisible)
        {
            <button type="button"
                    class="btn btn-primary"
                    disabled="@_isBusy"
                    @onclick="ShowCreateComponentForm">
                Add component
            </button>
        }
    </div>

    @if (_isComponentFormVisible)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="h5 mb-3">@(_editingComponentId is null ? "Add component" : "Edit component")</h3>
                <EditForm Model="_componentFormModel" OnValidSubmit="SaveComponentAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="component-name">Name</label>
                            <InputText id="component-name"
                                       class="form-control"
                                       @bind-Value="_componentFormModel.Name"
                                       disabled="@_isBusy" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="component-migrated">Date migrated</label>
                            <InputDate id="component-migrated"
                                       class="form-control"
                                       @bind-Value="_componentFormModel.DateMigrated"
                                       disabled="@_isBusy" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="component-current-url">Current location (URL)</label>
                            <InputText id="component-current-url"
                                       class="form-control"
                                       @bind-Value="_componentFormModel.CurrentLocationUrl"
                                       disabled="@_isBusy" />
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary" disabled="@_isBusy">
                            @(_isSaving ? "Saving…" : "Save")
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                disabled="@_isBusy"
                                @onclick="CancelComponentForm">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (_orderedComponents.Count == 0)
    {
        <div class="alert alert-light border text-center py-4" role="status">
            <p class="mb-0 text-muted">No components recorded yet. Add a component to track its migration history.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Date migrated</th>
                        <th>Current location</th>
                        <th>Last location</th>
                        <th style="width: 12rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var component in _orderedComponents)
                    {
                        var isDeleting = _deletingComponentId == component.Id;
                        <tr>
                            <td>
                                <a href="@($"/git-history/{RepositoryId}/components/{component.Id}")"
                                   class="text-decoration-none fw-semibold">
                                    @component.Name
                                </a>
                            </td>
                            <td>@component.DateMigrated.ToLocalTime().ToString("d")</td>
                            <td>
                                <ArtifactLocationButton Url="@component.CurrentLocationUrl"
                                                        Label="@component.Name" />
                            </td>
                            <td>
                                @{
                                    var lastLocation = ArtifactComponentDisplay.GetLastLocationRecord(component);
                                }
                                <ArtifactLocationButton Url="@lastLocation?.LastLocationUrl"
                                                        Label="@lastLocation?.Name" />
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/git-history/{RepositoryId}/components/{component.Id}")">
                                        View
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled="@_isBusy"
                                            @onclick="() => ShowEditComponentForm(component)">
                                        Edit
                                    </button>
                                    @if (isDeleting)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                disabled="@_isBusy"
                                                @onclick="() => ConfirmDeleteComponentAsync(component.Id)">
                                            Confirm
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@_isBusy"
                                                @onclick="CancelDeleteComponent">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                disabled="@_isBusy"
                                                @onclick="() => PromptDeleteComponent(component.Id)">
                                            Delete
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter]
    public Guid RepositoryId { get; set; }

    private GitRepository? _repository;
    private IReadOnlyList<ArtifactComponent> _orderedComponents = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isSaving;
    private bool _isRepositoryFormVisible;
    private bool _isComponentFormVisible;
    private Guid? _editingComponentId;
    private Guid? _deletingComponentId;
    private string? _errorMessage;
    private string _pageTitle = "Git history";
    private RepositoryFormModel _repositoryFormModel = new();
    private ComponentFormModel _componentFormModel = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _repository = null;
        _orderedComponents = [];
        _errorMessage = null;

        try
        {
            _repository = await GitRepositoryService.GetByIdAsync(RepositoryId);
            if (_repository is not null)
            {
                _pageTitle = $"Git history — {_repository.Name}";
                _orderedComponents = _repository.ArtifactComponents
                    .OrderBy(component => component.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowEditRepositoryForm()
    {
        if (_repository is null)
        {
            return;
        }

        _repositoryFormModel = new RepositoryFormModel
        {
            Name = _repository.Name
        };
        _isRepositoryFormVisible = true;
    }

    private void CancelRepositoryForm() => _isRepositoryFormVisible = false;

    private async Task SaveRepositoryAsync()
    {
        if (_repository is null)
        {
            return;
        }

        _isBusy = true;
        _isSaving = true;
        _errorMessage = null;

        try
        {
            await GitRepositoryService.UpdateAsync(
                _repository.Id,
                new GitRepositoryUpsert
                {
                    Name = _repositoryFormModel.Name
                });

            _isRepositoryFormVisible = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
            _isSaving = false;
        }
    }

    private void ShowCreateComponentForm()
    {
        _editingComponentId = null;
        _componentFormModel = new ComponentFormModel
        {
            DateMigrated = DateTime.Today
        };
        _isComponentFormVisible = true;
    }

    private void ShowEditComponentForm(ArtifactComponent component)
    {
        _editingComponentId = component.Id;
        _componentFormModel = new ComponentFormModel
        {
            Name = component.Name,
            DateMigrated = component.DateMigrated.LocalDateTime.Date,
            CurrentLocationUrl = component.CurrentLocationUrl
        };
        _isComponentFormVisible = true;
    }

    private void CancelComponentForm()
    {
        _isComponentFormVisible = false;
        _editingComponentId = null;
        _componentFormModel = new ComponentFormModel();
    }

    private async Task SaveComponentAsync()
    {
        if (_repository is null)
        {
            return;
        }

        _isBusy = true;
        _isSaving = true;
        _errorMessage = null;

        try
        {
            var upsert = new ArtifactComponentUpsert
            {
                Name = _componentFormModel.Name,
                DateMigrated = ToDateTimeOffset(_componentFormModel.DateMigrated),
                CurrentLocationUrl = _componentFormModel.CurrentLocationUrl
            };

            if (_editingComponentId is null)
            {
                await GitRepositoryService.CreateComponentAsync(_repository.Id, upsert);
            }
            else
            {
                await GitRepositoryService.UpdateComponentAsync(_editingComponentId.Value, upsert);
            }

            CancelComponentForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
            _isSaving = false;
        }
    }

    private void PromptDeleteComponent(Guid id) => _deletingComponentId = id;

    private void CancelDeleteComponent() => _deletingComponentId = null;

    private async Task ConfirmDeleteComponentAsync(Guid id)
    {
        _isBusy = true;
        _errorMessage = null;

        try
        {
            await GitRepositoryService.DeleteComponentAsync(id);
            _deletingComponentId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static DateTimeOffset ToDateTimeOffset(DateTime? date)
    {
        if (!date.HasValue)
        {
            throw new InvalidOperationException("Date migrated is required.");
        }

        return new DateTimeOffset(
            date.Value,
            TimeZoneInfo.Local.GetUtcOffset(date.Value));
    }

    private sealed class RepositoryFormModel
    {
        [Required]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class ComponentFormModel
    {
        [Required]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required]
        public DateTime? DateMigrated { get; set; }

        [Required]
        [Url]
        [StringLength(2000)]
        public string CurrentLocationUrl { get; set; } = string.Empty;
    }
}
