@page "/profiler"
@implements IDisposable
@inject ProfilerDashboardService ProfilerState
@using DigitalDevServices.DevDash.Services
@using DigitalDevServices.DevDash.Shared.Components
@using SQLCommandProfiler

<PageTitle>Profiler</PageTitle>

<h1 class="mb-1">SQL Command Profiler</h1>
<p class="text-muted mb-4">
    Start a live Extended Events trace against a SQL Server instance. Classified commands appear in the stream boxes below.
</p>

@if (!string.IsNullOrWhiteSpace(ProfilerState.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ProfilerState.ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ProfilerState.TargetWarningMessage))
{
    <div class="alert alert-warning" role="alert">@ProfilerState.TargetWarningMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ProfilerState.TargetReadyMessage))
{
    <div class="alert alert-success py-2" role="status">@ProfilerState.TargetReadyMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ProfilerState.FilterFeedbackMessage))
{
    <div class="alert alert-info py-2" role="status">@ProfilerState.FilterFeedbackMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ProfilerState.LastReportPath))
{
    <div class="alert alert-secondary py-2" role="status">
        Trace report written to: <code>@ProfilerState.LastReportPath</code>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <label class="form-label fw-semibold" for="profiler-sql-instance">SQL Server instance</label>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <input id="profiler-sql-instance"
                   class="form-control profiler-instance-input"
                   placeholder="Leave empty for default from configuration"
                   @bind="_sqlServerInstanceInput"
                   disabled="@(ProfilerState.IsRunning || ProfilerState.IsCheckingTarget)" />
            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@(ProfilerState.IsRunning || ProfilerState.IsCheckingTarget || !InstanceInputChanged)"
                    @onclick="ApplySqlServerTarget">
                Apply instance
            </button>
        </div>
        <p class="form-text mb-2">
            Optional. Uses credentials from <code>ConnectionStrings:Default</code> with a different server name (e.g. <code>myhost\SQLEXPRESS</code> or <code>myhost,1433</code>).
        </p>
        <p class="form-text mb-0">
            Active target: <strong>@ProfilerState.ActiveTargetDescription</strong>
        </p>
        @if (ProfilerState.IsCheckingTarget)
        {
            <p class="text-muted small mb-0 mt-2">Checking Extended Events on that instance…</p>
        }
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <button type="button"
            class="btn btn-primary"
            disabled="@(!CanBeginProfiling)"
            @onclick="BeginProfiling">
        Begin profiling
    </button>
    <button type="button"
            class="btn btn-secondary"
            disabled="@(!ProfilerState.IsRunning)"
            @onclick="StopProfiling">
        Stop profiling
    </button>
    <button type="button"
            class="btn btn-outline-secondary"
            disabled="@(!ProfilerState.IsRunning)"
            @onclick="OpenAddFilterDialog">
        Add new filter
    </button>
    <button type="button"
            class="btn btn-outline-secondary"
            disabled="@(ProfilerState.MasterEventCount == 0)"
            @onclick="OpenGroupSummaryDialog">
        View Group Summary
    </button>
    @if (ProfilerState.IsRunning)
    {
        <span class="align-self-center text-success fw-semibold">Trace running…</span>
    }
</div>

@if (ProfilerState.IsRunning && ProfilerState.RuntimeFilters.Count > 0)
{
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="fw-semibold small mb-2">Session filters</div>
            <ul class="list-group list-group-flush">
                @for (var i = 0; i < ProfilerState.RuntimeFilters.Count; i++)
                {
                    var filterIndex = i;
                    var filter = ProfilerState.RuntimeFilters[filterIndex];
                    <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2 px-0">
                        <code class="small">@filter.Effect @filter.Field / @filter.Pattern</code>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                @onclick="() => RemoveRuntimeFilter(filterIndex)">
                            Remove
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<div class="profiler-sections d-flex flex-column gap-2 mb-4">
    <CollapsibleSection Title="@($"EF Inserts ({ProfilerState.Inserts.Count})")"
                        DefaultExpanded="true">
        <HeaderActions>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@(ProfilerState.Inserts.Count == 0)"
                    @onclick="() => ClearBucket(ProfilerEventBucket.Insert)">
                Clear
            </button>
        </HeaderActions>
        <ChildContent>
            <ProfilerEventStream Title="INSERTS"
                             ShowHeader="false"
                             ThemeClass="profiler-theme-insert"
                             Items="ProfilerState.Inserts"
                             AutoScroll="_autoScrollInserts"
                             AutoScrollChanged="value => _autoScrollInserts = value"
                             OnSelect="OpenDetail" />
        </ChildContent>
    </CollapsibleSection>
    <CollapsibleSection Title="@($"EF Updates ({ProfilerState.Updates.Count})")"
                        DefaultExpanded="true">
        <HeaderActions>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@(ProfilerState.Updates.Count == 0)"
                    @onclick="() => ClearBucket(ProfilerEventBucket.Update)">
                Clear
            </button>
        </HeaderActions>
        <ChildContent>
            <ProfilerEventStream Title="UPDATES"
                             ShowHeader="false"
                             ThemeClass="profiler-theme-update"
                             Items="ProfilerState.Updates"
                             AutoScroll="_autoScrollUpdates"
                             AutoScrollChanged="value => _autoScrollUpdates = value"
                             OnSelect="OpenDetail" />
        </ChildContent>
    </CollapsibleSection>
    <CollapsibleSection Title="@($"EF Deletes ({ProfilerState.Deletes.Count})")"
                        DefaultExpanded="true">
        <HeaderActions>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@(ProfilerState.Deletes.Count == 0)"
                    @onclick="() => ClearBucket(ProfilerEventBucket.Delete)">
                Clear
            </button>
        </HeaderActions>
        <ChildContent>
            <ProfilerEventStream Title="DELETES"
                             ShowHeader="false"
                             ThemeClass="profiler-theme-delete"
                             Items="ProfilerState.Deletes"
                             AutoScroll="_autoScrollDeletes"
                             AutoScrollChanged="value => _autoScrollDeletes = value"
                             OnSelect="OpenDetail" />
        </ChildContent>
    </CollapsibleSection>
    <CollapsibleSection Title="@($"EF Read-Only ({ProfilerState.ReadOnlyEvents.Count})")"
                        DefaultExpanded="true">
        <HeaderActions>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@(ProfilerState.ReadOnlyEvents.Count == 0)"
                    @onclick="() => ClearBucket(ProfilerEventBucket.ReadOnly)">
                Clear
            </button>
        </HeaderActions>
        <ChildContent>
            <ProfilerEventStream Title="READ-ONLY"
                             ShowHeader="false"
                             ThemeClass="profiler-theme-readonly"
                             Items="ProfilerState.ReadOnlyEvents"
                             AutoScroll="_autoScrollReadOnly"
                             AutoScrollChanged="value => _autoScrollReadOnly = value"
                             OnSelect="OpenDetail" />
        </ChildContent>
    </CollapsibleSection>
    <CollapsibleSection Title="@($"Recognised Commands ({ProfilerState.RecognisedCommands.Count})")"
                        DefaultExpanded="true">
        <HeaderActions>
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    disabled="@(!ProfilerState.IsRunning)"
                    title="@($"Reload {ProfilerState.CommandLookupConfiguredPath}")"
                    @onclick="ReloadRecognisedCommands">
                Reload
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@(ProfilerState.RecognisedCommands.Count == 0)"
                    @onclick="() => ClearBucket(ProfilerEventBucket.RecognisedCommand)">
                Clear
            </button>
        </HeaderActions>
        <ChildContent>
            <ProfilerEventStream Title="Recognised Commands"
                             ShowHeader="false"
                             ThemeClass="profiler-theme-recognised"
                             ShowCommandNameColumn="true"
                             Items="ProfilerState.RecognisedCommands"
                             AutoScroll="_autoScrollRecognised"
                             AutoScrollChanged="value => _autoScrollRecognised = value"
                             OnSelect="OpenDetail" />
        </ChildContent>
    </CollapsibleSection>
    <CollapsibleSection Title="@($"Unknown ({ProfilerState.UnknownEvents.Count})")"
                        DefaultExpanded="false">
        <HeaderActions>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@(ProfilerState.UnknownEvents.Count == 0)"
                    @onclick="() => ClearBucket(ProfilerEventBucket.Unknown)">
                Clear
            </button>
        </HeaderActions>
        <ChildContent>
            <ProfilerEventStream Title="Unknown"
                             ShowHeader="false"
                             ThemeClass="profiler-theme-unknown"
                             Items="ProfilerState.UnknownEvents"
                             AutoScroll="_autoScrollUnknown"
                             AutoScrollChanged="value => _autoScrollUnknown = value"
                             OnSelect="OpenDetail" />
        </ChildContent>
    </CollapsibleSection>
</div>

<TextDetailModal IsOpen="_detailOpen"
                 Title="@_detailTitle"
                 Body="@_detailBody"
                 ShowFilterByButton="@(ProfilerState.IsRunning && _detailDisplay is not null)"
                 OnFilterBy="OpenFilterByFromDetail"
                 OnClose="CloseDetail" />

<ProfilerFilterDialog IsOpen="_filterDialogOpen"
                      SourceEvent="_filterSourceEvent"
                      InitialEffect="_filterInitialEffect"
                      InitialField="_filterInitialField"
                      InitialPattern="_filterInitialPattern"
                      ValidationMessage="_filterValidationMessage"
                      OnClose="CloseFilterDialog"
                      OnSubmit="SubmitFilterAsync" />

<ProfilerGroupSummaryDialog IsOpen="_groupSummaryOpen"
                            OnClose="CloseGroupSummaryDialog" />

@code {
    private bool _autoScrollInserts = true;
    private bool _autoScrollUpdates = true;
    private bool _autoScrollDeletes = true;
    private bool _autoScrollReadOnly = true;
    private bool _autoScrollRecognised = true;
    private bool _autoScrollUnknown = true;
    private bool _detailOpen;
    private string _detailTitle = string.Empty;
    private string _detailBody = string.Empty;
    private string _sqlServerInstanceInput = string.Empty;
    private string _appliedSqlServerInstanceInput = string.Empty;
    private bool _filterDialogOpen;
    private bool _groupSummaryOpen;
    private ExtendedEventInfo? _filterSourceEvent;
    private ProfilerEventFilterEffect _filterInitialEffect = ProfilerEventFilterEffect.Exclude;
    private ProfilerEventFilterField _filterInitialField = ProfilerEventFilterField.DatabaseName;
    private string _filterInitialPattern = string.Empty;
    private string? _filterValidationMessage;
    private ProfilerLiveEventDisplay? _detailDisplay;

    private bool InstanceInputChanged =>
        !string.Equals(_sqlServerInstanceInput.Trim(), _appliedSqlServerInstanceInput, StringComparison.Ordinal);

    private bool CanBeginProfiling =>
        ProfilerState.CanBeginProfiling && !InstanceInputChanged;

    protected override void OnInitialized()
    {
        ProfilerState.Changed += OnProfilerStateChanged;
    }

    private async Task ApplySqlServerTarget()
    {
        if (await ProfilerState.ApplySqlServerTargetAsync(_sqlServerInstanceInput))
        {
            _appliedSqlServerInstanceInput = _sqlServerInstanceInput.Trim();
        }
    }

    private void BeginProfiling() => ProfilerState.BeginProfiling();

    private void StopProfiling() => ProfilerState.StopProfiling();

    private void ClearBucket(ProfilerEventBucket bucket) => ProfilerState.ClearBucket(bucket);

    private void RemoveRuntimeFilter(int runtimeFilterIndex) =>
        ProfilerState.TryRemoveRuntimeFilter(runtimeFilterIndex, out _);

    private void ReloadRecognisedCommands() =>
        ProfilerState.TryReloadRecognisedCommandsLookup(out _);

    private void OnProfilerStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void OpenDetail(ProfilerLiveEventDisplay display)
    {
        _detailDisplay = display;
        _detailTitle = $"{display.Bucket}: {display.Title}";
        _detailBody = ProfilerEventDetailFormatter.Format(display);
        _detailOpen = true;
    }

    private Task CloseDetail()
    {
        _detailOpen = false;
        _detailDisplay = null;
        return Task.CompletedTask;
    }

    private void OpenAddFilterDialog()
    {
        _filterSourceEvent = null;
        _filterInitialEffect = ProfilerEventFilterEffect.Exclude;
        _filterInitialField = ProfilerEventFilterField.DatabaseName;
        _filterInitialPattern = string.Empty;
        _filterValidationMessage = null;
        _filterDialogOpen = true;
    }

    private void OpenFilterByFromDetail()
    {
        if (_detailDisplay is null)
        {
            return;
        }

        var info = _detailDisplay.Captured.Info;
        _filterSourceEvent = info;
        _filterInitialEffect = ProfilerEventFilterEffect.Exclude;
        _filterInitialField = ProfilerEventFilterField.ApplicationName;
        _filterInitialPattern = ProfilerEventFilterFieldValues.SuggestPattern(in info, _filterInitialField);
        _filterValidationMessage = null;
        _filterDialogOpen = true;
    }

    private Task CloseFilterDialog()
    {
        _filterDialogOpen = false;
        _filterValidationMessage = null;
        return Task.CompletedTask;
    }

    private void OpenGroupSummaryDialog() => _groupSummaryOpen = true;

    private Task CloseGroupSummaryDialog()
    {
        _groupSummaryOpen = false;
        return Task.CompletedTask;
    }

    private Task SubmitFilterAsync(ProfilerEventFilterDefinition definition)
    {
        if (!ProfilerState.TryAddRuntimeFilter(definition, out var errorMessage))
        {
            _filterValidationMessage = errorMessage;
            return InvokeAsync(StateHasChanged);
        }

        _filterDialogOpen = false;
        _filterValidationMessage = null;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ProfilerState.Changed -= OnProfilerStateChanged;
}
